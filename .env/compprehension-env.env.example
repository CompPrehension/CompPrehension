# CompPrehension environment template.
# Скопировать как `.env/compprehension-env.env` и заполнить значения.

# ---- Database ----
MYSQL_HOST=localhost
MYSQL_DATABASE=compph_dev
MYSQL_USER=root
MYSQL_PASSWORD=

# ---- SSL keystore ----
SERVER_SSL_KEY_STORE_PASSWORD=
SERVER_SSL_KEY_PASSWORD=

# ---- LTI 1.3 ----
# Ключ и публичный адрес инструмента.
# COMPPREHENSION_LTI_TOOL_BASE_URL=https://localhost:8433
# COMPPREHENSION_LTI_TOOL_PRIVATE_KEY_PKCS8_BASE64=

# ---- Keycloak OIDC ----
KEYCLOAK_CLIENT_ID=compph-dev
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER_URI=https://auth.compprehension.ru/realms/compph

# GITHUB API
GITHUB_SEARCH_TOKEN=
