tpg ExprEval() {
    cycle and ( $X.state == state:omitted or $X.state == state:unevaluated ) with operator X {
        n3 -> {
            cycle or ( X=>isInOperandOf($Y) ) with operator Y {
                n5 -> {
                    ask ( Y is class:StrictOrderOperator ) out true else {
                        conclude: error [
                            TEMPLATING_ID = "8";
                            skill = "earlyfinish_strict_order_operators_present";
                            EN.explanation = "${X} should be evaluated because its parent (${Y}) does not evaluate its operands in a strict order and so cannot block its evaluation";
                            RU.explanation = "${X} должен вычислиться, потому что его родитель (${Y}) не требует строгого порядка вычисления операндов и не может блокировать его вычисление";
                        ];
                    } as n6;
                    ask ( X =>isInOperandOf< (Y as class:StrictOrderOperator).firstOperandPlacement >(Y) ) out true else {
                        ask ( (Y as class:StrictOrderOperator).requiredFirstOperandValueToEvaluate<X=>isInOperandOf(Y).placement> == ExpectedValue:any ) out true else {
                            ask ( (Y as class:StrictOrderOperator).requiredFirstOperandValueToEvaluate<X=>isInOperandOf(Y).placement> == ExpectedValue:`true` == Y ->hasOperand< (Y as class:StrictOrderOperator).firstOperandPlacement >.evaluatesTo ) out true else {
                                conclude: correct [
                                    TEMPLATING_ID = "22";
                                    skill = "should_strict_order_current_operand_be_omitted_while_earlyfinish";
                                    EN.explanation = "${X} is not evaluated because it belongs to ${X=>isInOperandOf(Y).placement}[case='п'] operand of ${Y}[case='р'], whose ${Y.firstOperandPlacement} operand has the value ${Y->hasOperand<placement=Y.firstOperandPlacement>.evaluatesTo}, which blocks evaluation of ${X}[case='р']}";
                                    RU.explanation = "${X} не должен вычисляться, он находится в ${X=>isInOperandOf(Y).placement}[case='п'] операнде ${Y}[case='р'], чей ${Y.firstOperandPlacement} операнд имеет значение ${Y->hasOperand<placement=Y.firstOperandPlacement>.evaluatesTo}, что блокирует вычисление ${X}[case='р']";
                                ];
                            } as n18;
                            conclude: error [
                                TEMPLATING_ID = "20";
                                skill = "should_strict_order_current_operand_be_omitted_while_earlyfinish";
                                EN.explanation = "${X} should be evaluated because it belongs to ${X=>isInOperandOf(Y).placement}[case='п'] operand of ${Y}[case='р'], whose ${Y.firstOperandPlacement} operand has the value ${Y->hasOperand<placement=Y.firstOperandPlacement>.evaluatesTo}, which requires evaluating ${X}[case='р']}";
                                RU.explanation = "${X} должен вычислиться, потому что он находится в ${X=>isInOperandOf(Y).placement}[case='п'] операнде ${Y}[case='р'], чей ${Y.firstOperandPlacement} операнд имеет значение ${Y->hasOperand<placement=Y.firstOperandPlacement>.evaluatesTo}, что требует вычисления ${X}[case='р']";
                            ];
                        } as n14;
                        conclude: error [
                            TEMPLATING_ID = "16";
                            skill = "no_omitted_operands_despite_strict_order_while_earlyfinish";
                            EN.explanation = "${X} should be evaluated because its parent ${Y} always evaluates all its operands and cannot block ${X}[case='в']'s evaluation";
                            RU.explanation = "${X} должен вычислиться, потому что его родитель ${Y} всегда вычисляет все свои операнды и не может блокировать ${X}[case='в']";
                        ];
                    } as n10;
                    conclude: error [
                        TEMPLATING_ID = "12";
                        skill = "strict_order_first_operand_to_be_evaluated_while_earlyfinish";
                        EN.explanation = "${X} should be evaluated because it belongs to ${X=>isInOperandOf(Y).placement}[case='п'] operand ${Y}[case='р'] that is evaluated first and so cannot be blocked";
                        RU.explanation = "${X} должен вычислиться, потому что он находится в ${X=>isInOperandOf(Y).placement}[case='п'] операнде ${Y}[case='р'], который вычисляется первым и не может быть блокирован";
                    ];
                };
                null -> {
                    conclude: error [
                        TEMPLATING_ID = "24";
                        skill = "is_current_operator_strict_order_earlyfinish";
                        EN.explanation = "${X} should be evaluated because it is the top-level operator whose evaluation cannot be blocked";
                        RU.explanation = "${X} должен вычислиться, потому что он является верхним оператором выражения и не может быть блокирован";
                    ];
                };
            } as n4;
        };
    } as n2;
}
[
    TEMPLATING_ID = "1";
    EN.description = "all operators in the expression are fully evaluated";
    EN.error_prefix = "Expression evaluation cannot be finished now because ";
    EN.hint_prefix = "Expression evaluation can be finished because ";
    EN.nextStepExplanation = "Incorrect. It is necessary to check if all operators in the expression are completely evaluated";
    EN.nextStepQuestion = "It is necessary to determine whether all operators in the expression are fully evaluated";
    RU.description = "полностью вычислены все операторы в выражении";
    RU.error_prefix = "Вычисление выражения нельзя закончить потому, что ";
