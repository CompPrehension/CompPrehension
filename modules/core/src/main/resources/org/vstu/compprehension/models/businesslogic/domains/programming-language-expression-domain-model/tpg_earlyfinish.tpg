    TEMPLATING_ID = "6";
    EN.asNextStep = "We need to check that the operator ${Y} has a strict order of evaluation of operands";
    EN.endingCause = "the operator ${Y} ${result ? '' : 'not'} has a strict order of evaluation of operands";
    EN.question = "Does the operator ${Y} have a strict order of evaluation of operands?";
