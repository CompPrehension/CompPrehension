                                        skill = "should_strict_order_current_operand_be_omitted_while_solving";
                                        EN.explanation = "it belongs to ${X=>isInOperandOf(T).placement}[case='п'] operand of ${T}[case='р'] whose ${T.firstOperandPlacement} operand evaluates to ${T->hasOperand<placement=T.firstOperandPlacement>.evaluatesTo}.";
                                        RU.explanation = "он находится в ${X=>isInOperandOf(T).placement}[case='п'] операнде ${T}[case='р'], чей ${T.firstOperandPlacement} операнд имеет значение ${T->hasOperand<placement=T.firstOperandPlacement>.evaluatesTo}.";
                                    ];
                                };
                            } as n108;
                        } as n106;
                        conclude: correct [
                            TEMPLATING_ID = "107";
                            skill = "strict_order_first_operand_to_be_evaluated_while_solving";
                            EN.explanation = "it belongs to the ${X=>isInOperandOf(T).placement}[case='п'] operand of ${T}[case='р'], which is evaluated before the other operands of the latter.";
                            RU.explanation = "он находится в ${X=>isInOperandOf(T).placement}[case='п'] операнде ${T}[case='р'], а этот операнд вычисляется раньше остальных.";
                        ];
                    } as n102;
                    ask ( X != T ) out true else {
                        conclude: correct [
                            TEMPLATING_ID = "105";
                            skill = "is_current_operator_strict_order";
