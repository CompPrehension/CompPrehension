                    } as n103;
                    conclude: correct [
                        TEMPLATING_ID = "104";
                        skill = "is_current_operator_strict_order";
                        EN.explanation = "it is not a part of any operand of ${T} which has a strict order of operand evaluation";
                        RU.explanation = "он не находится в ${T}[case='п'], который имеет строгий порядок вычисления операндов.";
                    ];
                };
                null -> {
                    conclude: correct [
                        TEMPLATING_ID = "125";
                        muted = "true";
                        skill = "expression_strict_order_operators_present";
                        EN.explanation = "the expression does not contain unevaluated operators with strict order of operand evaluation.";
                        RU.explanation = "в выражении нет невычисленных операторов со строгим порядком вычисления операндов.";
                    ];
                };
                correct -> {
                    conclude: correct;
                };
                error -> {
                    conclude: error;
                };
            } as n100;
        };
        strict_central -> {
            ask ( obj:currentLanguage.isStrictOrderCentralOperands ) out true else {
                conclude: correct [
                    TEMPLATING_ID = "129";
                    muted = "true";
                    skill = "are_central_operands_strict_order";
                    EN.explanation = "${obj:currentLanguage} allows evaluating of function arguments in any order.";
                    RU.explanation = "${obj:currentLanguage} разрешает вычисление аргументов функции в любом порядке.";
                ];
            } as n127;
            cycle and ( $V.canHaveManyCentralOperands and ( forAny token V1 [$V1=>belongsTo($V)] {X1=>rightOf($V1)} ) and ( forAny token V2 [$V2=>belongsTo($V)] {X1=>leftOf($V2)} ) ) with operator V {
                n132 -> {
                    var W: separator = find separator w { (find token t {$w=>has($t)}) =>isBetween( find token V1 {$V1=>belongsTo(V) and X1=>rightOf($V1)}, X1 ) and not ( ( forAny token sep [$sep->belongsTo is class:separator] { $sep =>isBetween(find token t {$w=>has($t)}, X) } ) or ( forAny token call [ $call->belongsTo is class:operator and ($call->belongsTo as class:operator).canHaveManyCentralOperands ] { $call =>isBetween( find token V1 {$V1=>belongsTo(V) and X1=>rightOf($V1)}, find token t {$w=>has($t)} ) and ( forAny token call2 [ $call->belongsTo == $call2->belongsTo and $call != $call2 ] { not $call2 =>isBetween( find token V1 {$V1=>belongsTo(V) and X1=>rightOf($V1)}, find token t {$w=>has($t)} ) } ) } ) ) } {
                        false -> {
                            conclude: correct [
                                TEMPLATING_ID = "135";
                                skill = "no_comma_in_central_operands";
                                EN.explanation = "${obj:currentLanguage} evaluates function arguments from left to right but ${X} is in the first argument of ${V}";
                                RU.explanation = "${obj:currentLanguage} вычисляет аргументы функций слева направо, но ${X} находится в первом аргументе ${V}[case='р']";
                            ];
                        };
                        true -> {
                            ask ( forAny operator R [$R.state == state:unevaluated] { $R =>isBetween( find token V1 {$V1=>belongsTo(V) and X1=>rightOf($V1)}, W ) } ) out true else {
                                conclude: correct [
                                    TEMPLATING_ID = "141";
                                    skill = "previous_central_operands_are_unevaluated";
                                    EN.explanation = "${obj:currentLanguage} evaluates function arguments from left to right but all arguments of ${V} to the left of the argument containing ${X} are evaluated";
                                    RU.explanation = "${obj:currentLanguage} вычисляет аргументы функций слева направо, но все аргументы функции ${V} слева от аргумента содержащего ${X}[case='в'] вычислены";
                                ];
                            } as n137;
                            conclude: error [
                                TEMPLATING_ID = "139";
                                skill = "previous_central_operands_are_unevaluated";
                                EN.explanation = "${obj:currentLanguage} evaluates function arguments from left to right but at least one argument of ${V} to the left of ${X} is not evaluated";
                                RU.explanation = "${obj:currentLanguage} вычисляет аргументы функций слева направо, но не все аргументы функции ${V} слева от ${X}[case='р'] вычислены";
                            ];
                        };
                    } as n133;
                };
                null -> {
                    conclude: correct [
                        TEMPLATING_ID = "143";
                        skill = "no_current_in_many_central_operands";
                        EN.explanation = "${obj:currentLanguage} evaluates function arguments from left to right but ${X} is not inside any function argument";
                        RU.explanation = "${obj:currentLanguage} вычисляет аргументы функций слева направо, но ${X} не находится внутри вызова функции";
                    ];
                };
            } as n131;
        };
        correct -> {
            conclude: correct with ( { X.state = state:evaluated; forAll operand x_op [ $x_op=>isOperandOf(X) and $x_op.state != state:omitted ] {$x_op.state = state:used} } );
        };
        error -> {
            conclude: error;
        };
    } as `main.and`;
}
