tpg ExprEval(X: operator, X1: token = findExtreme x1 [$x1=>leftOf($x_token)] among token x_token {X=>has($x_token)}) {
    agg and {
        central -> {
            ask ( ( X.countOfTokens == 1 ) ) {
                true -> {
                    conclude: correct [
                        TEMPLATING_ID = "6";
                        skill = "central_operand_needed";
                        EN.explanation = "it has one token and so does not have a central operand.";
                        RU.explanation = "он имеет одну лексему и поэтому не может иметь центрального операнда.";
                    ];
                };
                false -> out;
            } as `central.isNeeded`;
            ask ( ( X.countOfTokens == 2 ) ) {
                true -> out;
                false -> {
                    conclude: null;
                };
            };
            var X2: token = find token x2 { $x2 is class:token and $x2=>belongsTo(X) and $x2=>rightOf(X1) } {
                true -> {
                    ask ( ( not X.needsOperand<OperandPlacement:left> or not ( X->hasOperand<OperandPlacement:left>.state == state:unevaluated ) ) and ( forAny operator i [$i is class:operator] { $i=>isBetween(X1, X2) and $i.state == state:unevaluated } ) ) out true else {
                        conclude: correct [
                            TEMPLATING_ID = "18";
                            skill = "is_central_operand_evaluated";
                            EN.explanation = "its central operand has been evaluated.";
                            RU.explanation = " его центральный операнд уже вычислен.";
                        ];
                    } as `central.isUnevaluated`;
                    conclude: error [
                        TEMPLATING_ID = "16";
                        `error` = "central.isUnevaluated";
                        law = "error_base_student_error_in_complex;error_base_student_error_unevaluated_operand;error_base_enclosing_operators";
                        skill = "is_central_operand_evaluated";
                        EN.explanation = " its central operand is not evaluated yet.";
                        RU.explanation = "еще не вычислен его центральный операнд.";
                    ];
                };
                false -> out;
            } as `central.findX2`;
        };
        left -> {
            ask ( X.needsOperand<OperandPlacement:left> ) out true else {
                conclude: correct [
                    TEMPLATING_ID = "22";
                    skill = "left_operand_needed";
                    EN.explanation = "it does not have a left operand";
                    RU.explanation = "он не имеет левого операнда";
                ];
            } as `left.isNeeded`;
            var Y: operator with (Y1: token = findExtreme y1_ex [$y1_ex=>isBetween($y1, X)] among token y1 {$y1=>belongsTo(Y) and $y1=>leftOf(X)}) = find operator Y { forAny token y_fin [ $y_fin == ( findExtreme y1_ex [$y1_ex=>isBetween($y1, X)] among token y1 { $y1=>leftOf(X) and ( $y1->belongsTo is class:operator and $y1->belongsTo.state == state:unevaluated ) and not ( forAny separator commaSep [$commaSep=>isBetween($y1, X)] { not ( forAny token f1 [$f1->belongsTo is class:operator] { forAny token f2 [$f2->belongsTo == $f1->belongsTo] { $commaSep=>isBetween($f1, $f2) and $f1=>isBetween($y1, X) and $f2=>isBetween($y1, X) } } ) } ) } ) ] {$Y=>has($y_fin)} } {
                false -> {
                    conclude: correct [
                        TEMPLATING_ID = "30";
                        skill = "left_competing_operator_present";
                        EN.explanation = "all operators to the left of it have been already evaluated or omitted.";
                        RU.explanation = "все операторы слева от него уже вычислены или опущены.";
                    ];
                };
                true -> {
                    ask ( forAny token y2 [ $y2 is class:token and $y2=>belongsTo(Y) and $y2 != Y1 ] {X=>isBetween(Y1, $y2)} ) out true else {
                        agg mutex {
                            `left.predetermining.2` -> {
                                ask ( forAny parenthesis p [$p is class:parenthesis] { forAny token p1 [$p1=>belongsTo($p)] { forAny token p2 [$p2=>belongsTo($p)] { X=>isBetween($p1, $p2) and not Y=>isBetween($p1, $p2) } } } ) out true else {
                                    conclude: null;
                                } as `left.predetermining.2.isXinParenthesis`;
                                conclude: correct [
                                    TEMPLATING_ID = "39";
                                    skill = "is_current_parenthesized_left_not";
                                    EN.explanation = "it is inside parentheses, while the closest ${Y} to its left lies outside them.";
                                    RU.explanation = "он находится в скобках, а ближайший к нему слева ${Y} находится за их пределами.";
                                ];
                            };
                            `left.predetermining.3` -> {
                                ask ( forAny parenthesis p [$p is class:parenthesis] { forAny token p1 [$p1=>belongsTo($p)] { forAny token p2 [$p2=>belongsTo($p)] { Y=>isBetween($p1, $p2) and not X=>isBetween($p1, $p2) } } } ) out true else {
                                    conclude: null;
                                } as `left.predetermining.3.isYinParenthesis`;
                                conclude: error [
                                    TEMPLATING_ID = "42";
                                    `error` = "left.parenthesis";
                                    law = "error_base_student_error_in_complex;error_base_parenthesized_operators";
                                    skill = "is_left_parenthesized_current_not";
                                    EN.explanation = "${Y} on its left must be evaluated first because ${Y} is in parentheses.";
                                    RU.explanation = "сначала должен быть вычислен ${Y} слева от него, так как ${Y} окружен круглыми скобками.";
                                ];
                            };
                            null -> {
                                ask ( ( X.precedence.compare(Y.precedence) == Comparison:less ) ) {
                                    true -> {
                                        conclude: correct [
                                            TEMPLATING_ID = "46";
                                            skill = "right_competing_to_left_precedence";
                                            EN.explanation = "it has a higher precedence than ${Y}.";
                                            RU.explanation = "он имеет приоритет выше, чем ${Y}[case='в'].";
                                        ];
                                    };
                                    false -> out;
                                } as `left.precedence`;
                                ask ( ( X.precedence.compare(Y.precedence) == Comparison:greater ) ) {
                                    true -> {
                                        conclude: error [
                                            TEMPLATING_ID = "48";
                                            `error` = "left.precedence";
                                            law = "error_base_higher_precedence_left";
                                            skill = "right_competing_to_left_precedence";
                                            EN.explanation = "${Y} on its left must be evaluated first because it has a higher precedence.";
                                            RU.explanation = "сначала должен быть вычислен ${Y}[case='и'] слева от него, который имеет более высокий приоритет.";
                                        ];
                                    };
                                    false -> out;
                                };
                                ask ( ( X.precedence.compare(Y.precedence) == Comparison:equal ) ) {
                                    true -> out;
                                    false -> {
                                        conclude: null;
                                    };
                                };
                                ask ( X.needsOperand<OperandPlacement:right> ) out true else {
                                    conclude: error [
                                        TEMPLATING_ID = "52";
                                        skill = "associativity_without_right_opposing_operand";
                                        EN.explanation = "${Y} on its left must be evaluated first - these operators have the same precedence, but are evaluated from left to right (have left associativity).";
                                        RU.explanation = "имеет одинаковый приоритет с ${Y}[case='т'] и левую ассоциативность (вычисляются слева направо).";
                                    ];
                                } as `rightOperandAssoc.isNeeded`;
                                ask ( ( Y.associativity == associativity:left ) ) {
                                    true -> {
                                        conclude: error [
                                            TEMPLATING_ID = "56";
                                            `error` = "left.associativity";
                                            law = "error_base_same_precedence_left_associativity_left";
                                            skill = "right_competing_to_left_associativity";
                                            EN.explanation = "${Y} on its left must be evaluated first - these operators have the same precedence, but are evaluated from left to right (have left associativity).";
                                            RU.explanation = "имеет одинаковый приоритет с ${Y}[case='т'] и левую ассоциативность (вычисляются слева направо).";
                                        ];
                                    };
                                    false -> out;
                                } as `left.associativity`;
                                ask ( ( Y.associativity == associativity:right ) ) {
                                    true -> out;
                                    false -> {
                                        conclude: null;
                                    };
                                };
                                conclude: correct [
                                    TEMPLATING_ID = "58";
                                    skill = "right_competing_to_left_associativity";
                                    EN.explanation = "it has the same precedence as ${Y} and right associativity.";
                                    RU.explanation = "имеет одинаковый приоритет с ${Y}[case='т'] и правую ассоциативность (вычисляются справа налево).";
                                ];
                            };
                        } as `left.predetermining`;
                    } as `left.isXinY`;
                    conclude: correct [
                        TEMPLATING_ID = "34";
                        skill = "left_operator_enclosed";
                        EN.explanation = "it is wrapped by the closest ${Y} to its left";
                        RU.explanation = "он заключен в ближайший оператор слева от него - ${Y}[case='и']";
                    ];
                };
            } as `left.findY`;
        };
        right -> {
            ask ( X.needsOperand<OperandPlacement:right> ) out true else {
                conclude: correct [
                    TEMPLATING_ID = "62";
                    skill = "right_operand_needed";
                    EN.explanation = "it does not have a right operand";
                    RU.explanation = "он не имеет правого операнда";
                ];
            } as `right.isNeeded`;
            var Z: operator with (Z1: token = findExtreme z1_ex [$z1_ex=>isBetween($z1, X)] among token z1 {$z1=>belongsTo(Z) and $z1=>rightOf(X)}) = find operator Z { forAny token z_fin [ $z_fin == ( findExtreme z1_ex [$z1_ex=>isBetween($z1, X)] among token z1 { $z1=>rightOf(X) and ( $z1->belongsTo is class:operator and $z1->belongsTo.state == state:unevaluated ) and not ( forAny separator commaSep [$commaSep=>isBetween($z1, X)] { not ( forAny token f1 [$f1->belongsTo is class:operator] { forAny token f2 [$f2->belongsTo == $f1->belongsTo] { $commaSep=>isBetween($f1, $f2) and $f1=>isBetween($z1, X) and $f2=>isBetween($z1, X) } } ) } ) } ) ] {$Z=>has($z_fin)} } {
                false -> {
                    conclude: correct [
                        TEMPLATING_ID = "70";
                        EN.explanation = "all operators to the right of it have been already evaluated or omitted.";
                        RU.explanation = "все операторы справа от него уже вычислены или опущены.";
                    ];
                };
                true -> {
                    ask ( forAny token z2 [ $z2 is class:token and $z2=>belongsTo(Z) and $z2 != Z1 ] {X=>isBetween(Z1, $z2)} ) out true else {
                        agg mutex {
                            `right.predetermining.2` -> {
                                ask ( forAny parenthesis p [$p is class:parenthesis] { forAny token p1 [$p1=>belongsTo($p)] { forAny token p2 [$p2=>belongsTo($p)] { X=>isBetween($p1, $p2) and not Z=>isBetween($p1, $p2) } } } ) out true else {
                                    conclude: null;
                                } as `right.predetermining.2.isXinParenthesis`;
                                conclude: correct [
                                    TEMPLATING_ID = "79";
                                    skill = "is_current_parenthesized_right_not";
                                    EN.explanation = "it is inside parentheses, while the closest ${Z} to its right lies outside them.";
                                    RU.explanation = "он находится в скобках, а ближайший к нему справа ${Z} находится за их пределами.";
                                ];
                            };
                            `right.predetermining.3` -> {
                                ask ( forAny parenthesis p [$p is class:parenthesis] { forAny token p1 [$p1=>belongsTo($p)] { forAny token p2 [$p2=>belongsTo($p)] { Z=>isBetween($p1, $p2) and not X=>isBetween($p1, $p2) } } } ) out true else {
                                    conclude: null;
                                } as `right.predetermining.3.isZinParenthesis`;
                                conclude: error [
                                    TEMPLATING_ID = "82";
                                    law = "error_base_parenthesized_operators;error_base_student_error_in_complex";
                                    skill = "is_right_parenthesized_current_not";
                                    EN.explanation = "${Z} on its right must be evaluated first because ${Z} is in parentheses.";
                                    RU.explanation = "сначала должен быть вычислен ${Z} справа от него, так как ${Z} окружен круглыми скобками.";
                                ];
                            };
                            null -> {
                                ask ( ( X.precedence.compare(Z.precedence) == Comparison:less ) ) {
                                    true -> {
                                        conclude: correct [
                                            TEMPLATING_ID = "86";
                                            skill = "left_competing_to_right_precedence";
                                            EN.explanation = "it has a higher precedence than ${Z}.";
                                            RU.explanation = "он имеет приоритет выше, чем у ${Z}[case='в'].";
                                        ];
                                    };
                                    false -> out;
                                } as `right.precedence`;
                                ask ( ( X.precedence.compare(Z.precedence) == Comparison:greater ) ) {
                                    true -> {
                                        conclude: error [
                                            TEMPLATING_ID = "88";
                                            `error` = "right.precedence";
                                            law = "error_base_higher_precedence_right";
                                            skill = "left_competing_to_right_precedence";
                                            EN.explanation = "${Z} on its right must be evaluated first because it has a higher precedence.";
                                            RU.explanation = "сначала должен быть вычислен ${Z}[case='и'] справа от него, который имеет более высокий приоритет.";
                                        ];
                                    };
                                    false -> out;
                                };
                                ask ( ( X.precedence.compare(Z.precedence) == Comparison:equal ) ) {
                                    true -> out;
                                    false -> {
                                        conclude: null;
                                    };
                                };
                                ask ( X.needsOperand<OperandPlacement:left> ) out true else {
                                    conclude: error [
                                        TEMPLATING_ID = "92";
                                        skill = "associativity_without_left_opposing_operand";
                                        EN.explanation = " ${Z} on its right must be evaluated first - these operators have the same precedence, but are evaluated from right to left (have right associativity).";
                                        RU.explanation = "сначала должен быть вычислен ${Z}[case='и'] справа от него: эти операторы имеют одинаковый приоритет, и вычисляются справа налево (правоассоциативны).";
                                    ];
                                } as `leftOperandAssoc.isNeeded`;
                                ask ( ( Z.associativity == associativity:right ) ) {
                                    true -> {
                                        conclude: error [
                                            TEMPLATING_ID = "96";
                                            `error` = "right.associativity";
                                            law = "error_base_same_precedence_right_associativity_right";
                                            skill = "left_competing_to_right_associativity";
                                            EN.explanation = " ${Z} on its right must be evaluated first - these operators have the same precedence, but are evaluated from right to left (have right associativity).";
                                            RU.explanation = "сначала должен быть вычислен ${Z}[case='и'] справа от него: эти операторы имеют одинаковый приоритет, и вычисляются справа налево (правоассоциативны).";
                                        ];
