                                            EN.explanation = "${T.firstOperandPlacement} operand ${T}[case='р'] had already been evaluated, and that operator always evaluates all its operands";
                                            RU.explanation = "${T.firstOperandPlacement} операнд ${T}[case='р'] уже вычислен, и этот оператор всегда вычисляет все свои операнды";
                                        ];
