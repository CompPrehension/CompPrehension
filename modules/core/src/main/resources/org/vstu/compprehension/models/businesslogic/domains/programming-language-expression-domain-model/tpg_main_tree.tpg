                                    skill = "left_competing_to_right_associativity";
                                    EN.explanation = " it has the same precedence as ${Z} and left associativity.";
                                    RU.explanation = " имеет одинаковый приоритет с ${Z}[case='т'] и левую ассоциативность (вычисляются слева направо).";
                                ];
                            };
                        } as `right.predetermining`;
                    } as `right.isXinZ`;
                    conclude: correct [
                        TEMPLATING_ID = "74";
                        skill = "right_operator_enclosed";
                        EN.explanation = "it is wrapped by the closest ${Z} to its right";
                        RU.explanation = "он заключен в ближайший оператор справа от него - ${Z}[case='и']";
                    ];
                };
            } as `right.findZ`;
        };
        strict -> {
            cycle and ( true ) with StrictOrderOperator T {
                `strict.Tcycle` -> {
                    ask ( not X=>isInOperandOf(T) ) out true else {
                        ask ( X =>isInOperandOf<T.firstOperandPlacement>(T) ) out true else {
                            cycle and ( $U.state == state:unevaluated and $U =>isInOperandOf<T.firstOperandPlacement>(T) ) with operator U {
                                n109 -> {
                                    conclude: error [
                                        TEMPLATING_ID = "110";
                                        `error` = "strict.leftShouldBeEvaluatedFirst";
                                        law = "error_base_student_error_strict_operands_order";
                                        skill = "is_first_operand_of_strict_order_operator_fully_evaluated";
                                        EN.explanation = "${U} that belongs to ${U=>isInOperandOf(T).placement}[case='п'] operand ${T}[case='р'] should be evaluated before it";
                                        RU.explanation = "${U}, стоящий в ${U=>isInOperandOf(T).placement}[case='п'] операнде ${T}[case='р'], должен быть вычислен ранее";
                                    ];
                                };
                                null -> {
                                    ask ( T.requiredFirstOperandValueToEvaluate<X=>isInOperandOf(T).placement> != ExpectedValue:any ) out true else {
