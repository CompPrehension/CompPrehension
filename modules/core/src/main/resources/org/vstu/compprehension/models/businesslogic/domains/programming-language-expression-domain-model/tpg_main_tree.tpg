                                            law = "error_base_student_error_strict_operands_order";
                                            skill = "should_strict_order_current_operand_be_omitted_while_solving";
                                            EN.explanation = "it belongs to ${X=>isInOperandOf(T).placement}[case='п'] operand of ${T}[case='р'] whose ${T.firstOperandPlacement} operand evaluates to ${T->hasOperand<placement=T.firstOperandPlacement>.evaluatesTo} which forbids evaluation of ${X}[case='р'].";
                                            RU.explanation = "он находится в ${X=>isInOperandOf(T).placement}[case='п'] операнде ${T}[case='р'], чей ${T.firstOperandPlacement} операнд имеет значение ${T->hasOperand<placement=T.firstOperandPlacement>.evaluatesTo}, что блокирует вычисление ${X}[case='р'].";
                                        ];
                                    };
                                    conclude: correct [
