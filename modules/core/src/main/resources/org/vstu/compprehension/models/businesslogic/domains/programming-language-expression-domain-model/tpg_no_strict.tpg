tpg ExprEval(X: operator, X1: token = findExtreme x1 [$x1=>leftOf($x_token)] among token x_token {X=>has($x_token)}) {
    agg and {
        central -> {
            ask ( ( X.countOfTokens == 1 ) ) {
                true -> {
                    conclude: correct [
                        TEMPLATING_ID = "6";
                        skill = "central_operand_needed";
                        EN.explanation = "${val('X','и')} has one token and so does not have a central operand.";
                        RU.explanation = "${val('X','и')}  имеет одну лексему и поэтому не может иметь центрального операнда.";
                    ];
                };
                false -> out;
            } as `central.isNeeded`;
            ask ( ( X.countOfTokens == 2 ) ) {
                true -> out;
                false -> {
                    conclude: null;
                };
            };
            var X2: token = find token x2 { $x2 is class:token and $x2=>belongsTo(X) and $x2=>rightOf(X1) } {
                true -> {
                    ask ( (true or true) and ( forAny operator i [$i is class:operator] { $i=>isBetween(X1, X2) and $i.state == state:unevaluated } ) ) out true else {
                        conclude: correct [
                            TEMPLATING_ID = "18";
                            skill = "is_central_operand_evaluated";
                            EN.explanation = "its central operand has been evaluated.";
                            RU.explanation = " его центральный операнд уже вычислен.";
                        ];
                    } as `central.isUnevaluated`;
                    conclude: error [
                        TEMPLATING_ID = "16";
                        `error` = "central.isUnevaluated";
                        law = "error_base_student_error_in_complex;error_base_student_error_unevaluated_operand;error_base_enclosing_operators";
                        skill = "is_central_operand_evaluated";
                        EN.explanation = " its central operand is not evaluated yet.";
                        RU.explanation = "еще не вычислен его центральный операнд.";
                    ];
                };
                false -> out;
            } as `central.findX2`;
        };
        left -> {
            ask ( X.needsOperand<OperandPlacement:left> ) out true else {
                conclude: correct [
                    TEMPLATING_ID = "22";
                    skill = "left_operand_needed";
                    EN.explanation = "it does not have a left operand";
                    RU.explanation = "он не имеет левого операнда";
                ];
            } as `left.isNeeded`;
            var Y1: token with (Y: operator = Y1->belongsTo as class:operator) = findExtreme y1_ex [$y1_ex=>isBetween($y1, X)] among token y1 { $y1 is class:token and $y1=>leftOf(X) and ( $y1->belongsTo is class:operator and $y1->belongsTo.state == state:unevaluated ) and not ( forAny separator commaSep [$commaSep=>isBetween($y1, X)] { not ( forAny token f1 [$f1->belongsTo is class:operator] { forAny token f2 [$f2->belongsTo == $f1->belongsTo] { $commaSep=>isBetween($f1, $f2) and $f1=>isBetween($y1, X) and $f2=>isBetween($y1, X) } } ) } ) } {
                false -> {
                    conclude: correct [
                        TEMPLATING_ID = "30";
                        skill = "left_competing_operator_present";
                        EN.explanation = "all operators to the left of it have been already evaluated.";
                        RU.explanation = "все операторы слева от него уже вычислены.";
                    ];
                };
                true -> {
                    ask ( forAny token y2 [ $y2 is class:token and $y2=>belongsTo(Y) and $y2 != Y1 ] {X=>isBetween(Y1, $y2)} ) out true else {
                        agg mutex {
                            `left.predetermining.2` -> {
                                ask ( forAny parenthesis p [$p is class:parenthesis] { forAny token p1 [$p1=>belongsTo($p)] { forAny token p2 [$p2=>belongsTo($p)] { X=>isBetween($p1, $p2) and not Y=>isBetween($p1, $p2) } } } ) out true else {
                                    conclude: null;
                                } as `left.predetermining.2.isXinParenthesis`;
                                conclude: correct;
                            };
                            `left.predetermining.3` -> {
                                ask ( forAny parenthesis p [$p is class:parenthesis] { forAny token p1 [$p1=>belongsTo($p)] { forAny token p2 [$p2=>belongsTo($p)] { Y=>isBetween($p1, $p2) and not X=>isBetween($p1, $p2) } } } ) out true else {
                                    conclude: null;
                                } as `left.predetermining.3.isYinParenthesis`;
                                conclude: error;
                            };
                            null -> {
                                ask ( ( X.precedence.compare(Y.precedence) == Comparison:less ) ) {
                                    true -> {
                                        conclude: correct [
                                            TEMPLATING_ID = "44";
                                            skill = "right_competing_to_left_precedence";
                                            EN.explanation = "it has a higher priority than ${val('Y','в')}.";
                                            RU.explanation = "он имеет приоритет выше, чем ${val('Y','в')}.";
                                        ];
                                    };
                                    false -> out;
                                } as `left.precedence`;
                                ask ( ( X.precedence.compare(Y.precedence) == Comparison:greater ) ) {
                                    true -> {
                                        conclude: error [
                                            TEMPLATING_ID = "46";
                                            `error` = "left.precedence";
                                            law = "error_base_higher_precedence_left";
                                            skill = "right_competing_to_left_precedence";
                                            EN.explanation = "${val('Y','и')} on its left must be evaluated first because it has a higher precedence.";
                                            RU.explanation = "сначала должен быть вычислен ${val('Y','и')} слева от него, который имеет более высокий приоритет.";
                                        ];
                                    };
                                    false -> out;
                                };
                                ask ( ( X.precedence.compare(Y.precedence) == Comparison:equal ) ) {
                                    true -> out;
                                    false -> {
                                        conclude: null;
                                    };
                                };
                                ask ( X.needsOperand<OperandPlacement:right> ) out true else {
                                    conclude: error [
                                        TEMPLATING_ID = "50";
                                        skill = "associativity_without_right_opposing_operand";
                                        EN.explanation = " ${val('Y','и')} on its left must be evaluated first - these operators have the same precedence, but are evaluated from left to right (have left associativity).";
                                        RU.explanation = "сначала должен быть вычислен ${val('Y','и')} слева от него: эти операторы имеют одинаковый приоритет, и вычисляются слева направо (левоассоциативны).";
                                    ];
                                } as `rightOperandAssoc.isNeeded`;
                                ask ( ( Y.associativity == associativity:left ) ) {
                                    true -> {
                                        conclude: error [
                                            TEMPLATING_ID = "54";
                                            `error` = "left.associativity";
                                            law = "error_base_same_precedence_left_associativity_left";
                                            skill = "right_competing_to_left_associativity";
                                            EN.explanation = " ${val('Y','и')} on its left must be evaluated first - these operators have the same precedence, but are evaluated from left to right (have left associativity).";
                                            RU.explanation = " имеет одинаковый приоритет с ${val('Y','р')} и правую ассоциативность (вычисляются справа налево) .";
                                        ];
                                    };
                                    false -> out;
                                } as `left.associativity`;
                                ask ( ( Y.associativity == associativity:right ) ) {
                                    true -> out;
                                    false -> {
                                        conclude: null;
                                    };
                                };
                                conclude: correct [
                                    TEMPLATING_ID = "56";
                                    skill = "right_competing_to_left_associativity";
                                    EN.explanation = "it has the same precedence as ${val('Y','р')} and right associativity.";
                                    RU.explanation = " имеет одинаковый приоритет с ${val('Y','р')} и правую ассоциативность (вычисляются справа налево) .";
                                ];
                            };
                        } as `left.predetermining`;
                    } as `left.predetermining.1.isXinY`;
                    conclude: correct [
                        TEMPLATING_ID = "34";
                        skill = "left_operator_enclosed";
                        EN.explanation = "it is enclosed in the ${val('Y','и')}, which is closest to it from the left";
                        RU.explanation = "он заключен в ближайший оператор слева к нему ${val('Y','и')}";
                    ];
                };
            } as `left.findY`;
        };
        right -> {
            ask ( X.needsOperand<OperandPlacement:right> ) out true else {
                conclude: correct [
                    TEMPLATING_ID = "60";
                    skill = "right_operand_needed";
                    EN.explanation = "it does not have a right operand";
                    RU.explanation = "он не имеет правого операнда";
                ];
            } as `right.isNeeded`;
            var Z1: token with (Z: operator = Z1->belongsTo as class:operator) = findExtreme z1_ex [$z1_ex=>isBetween($z1, X)] among token z1 { $z1 is class:token and $z1=>rightOf(X) and ( $z1->belongsTo is class:operator and $z1->belongsTo.state == state:unevaluated ) and not ( forAny separator commaSep [$commaSep=>isBetween($z1, X)] { not ( forAny token f1 [$f1->belongsTo is class:operator] { forAny token f2 [$f2->belongsTo == $f1->belongsTo] { $commaSep=>isBetween($f1, $f2) and $f1=>isBetween($z1, X) and $f2=>isBetween($z1, X) } } ) } ) } {
                false -> {
                    conclude: correct [
                        TEMPLATING_ID = "68";
                        EN.explanation = "All operators to the right of it have been already evaluated.";
                        RU.explanation = "Все операторы справа от него уже вычислены.";
                    ];
                };
                true -> {
                    ask ( forAny token z2 [ $z2 is class:token and $z2=>belongsTo(Z) and $z2 != Z1 ] {X=>isBetween(Z1, $z2)} ) out true else {
                        agg mutex {
                            `right.predetermining.2` -> {
                                ask ( forAny parenthesis p [$p is class:parenthesis] { forAny token p1 [$p1=>belongsTo($p)] { forAny token p2 [$p2=>belongsTo($p)] { X=>isBetween($p1, $p2) and not Z=>isBetween($p1, $p2) } } } ) out true else {
                                    conclude: null;
                                } as `right.predetermining.2.isXinParenthesis`;
                                conclude: correct;
                            };
                            `right.predetermining.3` -> {
                                ask ( forAny parenthesis p [$p is class:parenthesis] { forAny token p1 [$p1=>belongsTo($p)] { forAny token p2 [$p2=>belongsTo($p)] { Z=>isBetween($p1, $p2) and not X=>isBetween($p1, $p2) } } } ) out true else {
                                    conclude: null;
                                } as `right.predetermining.3.isZinParenthesis`;
                                conclude: error;
                            };
                            null -> {
                                ask ( ( X.precedence.compare(Z.precedence) == Comparison:less ) ) {
                                    true -> {
                                        conclude: correct [
                                            TEMPLATING_ID = "82";
                                            skill = "left_competing_to_right_precedence";
                                            EN.explanation = "it has a higher priority than ${val('Y','в')}.";
                                            RU.explanation = "он имеет приоритет выше, чем ${val('Y','в')}.";
                                        ];
                                    };
                                    false -> out;
                                } as `right.precedence`;
                                ask ( ( X.precedence.compare(Z.precedence) == Comparison:greater ) ) {
                                    true -> {
                                        conclude: error [
                                            TEMPLATING_ID = "84";
                                            `error` = "right.precedence";
                                            law = "error_base_higher_precedence_right";
                                            skill = "left_competing_to_right_precedence";
                                            EN.explanation = "${val('Y','и')} on its right must be evaluated first because it has a higher precedence.";
                                            RU.explanation = "сначала должен быть вычислен ${val('Y','и')} справа от него, который имеет более высокий приоритет.";
                                        ];
                                    };
                                    false -> out;
                                };
                                ask ( ( X.precedence.compare(Z.precedence) == Comparison:equal ) ) {
                                    true -> out;
                                    false -> {
                                        conclude: null;
                                    };
                                };
                                ask ( X.needsOperand<OperandPlacement:left> ) out true else {
                                    conclude: error [
                                        TEMPLATING_ID = "88";
                                        skill = "associativity_without_left_opposing_operand";
                                        EN.explanation = " ${val('Y','и')} on its right must be evaluated first - these operators have the same precedence, but are evaluated from right to left (have right associativity).";
                                        RU.explanation = "сначала должен быть вычислен ${val('Y','и')} справа от него: эти операторы имеют одинаковый приоритет, и вычисляются справа налево (правоассоциативны).";
                                    ];
                                } as `leftOperandAssoc.isNeeded`;
                                ask ( ( Z.associativity == associativity:right ) ) {
                                    true -> {
                                        conclude: error [
                                            TEMPLATING_ID = "92";
                                            `error` = "right.associativity";
                                            law = "error_base_same_precedence_right_associativity_right";
                                            skill = "left_competing_to_right_associativity";
                                            EN.explanation = " ${val('Y','и')} on its right must be evaluated first - these operators have the same precedence, but are evaluated from right to left (have right associativity).";
                                            RU.explanation = "сначала должен быть вычислен ${val('Y','и')} справа от него: эти операторы имеют одинаковый приоритет, и вычисляются справа налево (правоассоциативны).";
                                        ];
                                    };
                                    false -> out;
                                } as `right.associativity`;
                                ask ( ( Z.associativity == associativity:left ) ) {
                                    true -> out;
                                    false -> {
                                        conclude: null;
                                    };
                                };
                                conclude: correct [
                                    TEMPLATING_ID = "94";
                                    skill = "left_competing_to_right_associativity";
                                    EN.explanation = "it has the same precedence as ${val('Y','р')} and left associativity.";
                                    RU.explanation = " имеет одинаковый приоритет с ${val('Y','р')} и левую ассоциативность (вычисляются слева направо) .";
                                ];
                            };
                        } as `right.predetermining`;
                    } as `right.predetermining.1.isXinZ`;
                    conclude: correct [
                        TEMPLATING_ID = "72";
                        skill = "right_operator_enclosed";
                        EN.explanation = "it is enclosed in the ${val('Y','и')}, which is closest to it from the right";
                        RU.explanation = "он заключен в ближайший оператор справа к нему ${val('Y','и')}";
                    ];
                };
            } as `right.findZ`;
        };
        correct -> {
            conclude: correct with ( { if (X.needsOperand<OperandPlacement:center>) forAll operand c [ $c is class:operand and $c =>isBetween( X1, find token x2 { $x2 is class:token and $x2=>belongsTo(X) and $x2=>rightOf(X1) } ) and $c.state == state:evaluated ] { { $c +=>isOperandOf<OperandPlacement:center>(X); $c.state = state:used } } ; if (X.needsOperand<OperandPlacement:left>) forAll operand a_ [ $a_ == ( findExtreme a_ex [$a_ex=>isBetween($a, X)] among operand a { $a is class:operand and $a.state == state:evaluated and $a=>leftOf(X) } ) ] { { $a_ +=>isOperandOf<OperandPlacement:left>(X); $a_.state = state:used } } ; if (X.needsOperand<OperandPlacement:right>) forAll operand b_ [ $b_ == ( findExtreme b_ex [$b_ex=>isBetween($b, X)] among operand b { $b is class:operand and $b.state == state:evaluated and $b=>rightOf(X) } ) ] { { $b_ +=>isOperandOf<OperandPlacement:right>(X); $b_.state = state:used } } ; X.state = state:evaluated; if (X.isNot) X.evaluatesTo = not X->hasOperand.evaluatesTo ; if (X.isAnd) X.evaluatesTo = ( forAll operand x_op [$x_op=>isOperandOf(X)] {$x_op.evaluatesTo} ) ; if (X.isOr) X.evaluatesTo = ( forAny operand x_op [$x_op=>isOperandOf(X)] {$x_op.evaluatesTo} ) ; if (X.isComma) X.evaluatesTo = X->hasOperand<OperandPlacement:right>.evaluatesTo ; if (X.isTConditional) X.evaluatesTo = ( find operand x_op { X=>hasOperand($x_op) and (X as class:StrictOrderOperator).requiredFirstOperandValueToEvaluate<X=>hasOperand($x_op).placement> == ( X ->hasOperand< (X as class:StrictOrderOperator).firstOperandPlacement >.evaluatesTo ? ExpectedValue:`true` : ExpectedValue:`false` ) } ).evaluatesTo } );
        };
        error -> {
            conclude: error;
        };
    } as `main.and`;
}
