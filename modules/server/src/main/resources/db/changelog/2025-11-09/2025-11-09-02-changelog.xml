<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="20251109-1" author="Dmitry Shashkov">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                select exists(select 1 from domain where short_name = 'ctrlFlow_dt')
            </sqlCheck>
        </preConditions>
        <delete tableName="domain">
            <where>short_name = 'ctrlFlow_dt'</where>
        </delete>
    </changeSet>

    <changeSet id="20251109-2" author="Dmitry Shashkov">
        <insert tableName="domain">
            <column name="name" value="ControlFlowDTDomain" />
            <column name="short_name" value="ctrlFlow_dt" />
            <column name="version" value="2" />
            <column name="options_json" value="{}" />
        </insert>
    </changeSet>

</databaseChangeLog>