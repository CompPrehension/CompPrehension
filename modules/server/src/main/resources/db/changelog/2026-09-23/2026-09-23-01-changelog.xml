                  and column_name = 'denied_question_template_ids' and is_nullable = 'YES'
            </sqlCheck>
        </preConditions>
        <addNotNullConstraint tableName="question_request_log" columnName="denied_question_template_ids" columnDataType="JSON" defaultNullValue="[]"/>
        <rollback>
            <dropNotNullConstraint tableName="question_request_log" columnName="denied_question_template_ids" columnDataType="JSON"/>
        </rollback>
    </changeSet>

    <changeSet id="2026-09-23-01-user-email-backfill" author="Artem Prokudin">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="user" columnName="email"/>
        </preConditions>
        <sql>
            update user set email = concat(replace(first_name, ' ', ''), '@vstu.ru')
            where email is null and first_name is not null
        </sql>
        <rollback/>
    </changeSet>

    <changeSet id="2026-09-23-01-user-external-user-id-backfill" author="Artem Prokudin">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="user" columnName="external_user_id"/>
        </preConditions>
        <sql>
            update user set external_user_id = substring_index(external_id, '_', -1)
            where external_user_id is null and instr(external_id, '_') > 0
        </sql>
        <rollback/>
    </changeSet>

