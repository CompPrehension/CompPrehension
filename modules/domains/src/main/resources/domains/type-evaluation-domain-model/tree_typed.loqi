                                _ -> {
                                    ask (T == L or T == R) out false else {
                                        conclude: error [
                                            skill = "membership_test";
                                            hypothesis = "operand_type";
                                            RU.explanation = "в значении типа ${R} нельзя искать значение типа ${L}, а проверка вхождения и не возвращает свои операнды.";
                                            EN.explanation = "a value of type ${L} cannot be searched for in a value of type ${R}, and a membership test does not return its operands anyway.";
                                            RU.reason = "Результат берёт тип одного из операндов.";
                                            EN.reason = "The result takes the type of one of the operands.";
