                                        skill = "membership_test";
                                        RU.explanation = "в значении типа ${R} нельзя искать значение типа ${L}.";
                                        EN.explanation = "a value of type ${L} cannot be searched for in a value of type ${R}.";
                                    ]
                                };
                            } as inapplicableMembershipHypotheses
                        };
                    } as membershipApplicability
                };
            } as comparisonKindSwitch
        };
        OperationGroup:indexing -> {
            var Left : Expr = leftOf(E, Old, New);
            var Right : Expr = rightOf(E, Old, New);
            var X : Type = (Left->hasType);
            var I : Type = (Right->hasType);

            // Порядок развилок задаёт навыки: словарь — отдельно, неприменимость — до выбора вида элемента.
            // Словарь с ключом изменяемого типа — неприменимость.
            ask (X is class:MappingType and I.isHashable) {
                true -> {
                    var M : MappingType = (X as class:MappingType);
                    agg hyp {
                        _ -> {
                            ask (T == M->valueType) out false else {
                                conclude: correct [
                                    skill = "mapping_value_access";
                                    hypothesis = "rule";
                                    RU.explanation = "по ключу из словаря типа ${X} берётся хранящееся под ним значение, а значения там имеют тип ${M->valueType}.";
                                    EN.explanation = "accessing a dictionary of type ${X} by key takes the value stored under that key, and its values have type ${M->valueType}.";
                                ];
                            };
                            conclude: null
                        };
                        _ -> {
                            ask (T == M->keyType) out false else {
                                conclude: error [
                                    skill = "mapping_value_access";
                                    hypothesis = "key_instead_of_value";
                                    RU.explanation = "по ключу из словаря возвращается хранящееся под ним значение, а не сам ключ.";
                                    EN.explanation = "accessing a dictionary by key returns the value stored under that key, not the key itself.";
                                    RU.reason = "Обращение к словарю по ключу даёт тип ключа.";
                                    EN.reason = "Accessing a dictionary by key gives the key type.";
                                ];
                            };
                            conclude: null
                        };
                        _ -> {
                            ask (T == X) out false else {
                                conclude: error [
                                    skill = "mapping_value_access";
                                    hypothesis = "container_type";
                                    RU.explanation = "обращение по ключу достаёт из словаря одно значение, а не словарь целиком.";
                                    EN.explanation = "access by key takes a single value out of the dictionary, not the whole dictionary.";
                                    RU.reason = "Обращение к словарю по ключу даёт словарь.";
                                    EN.reason = "Accessing a dictionary by key gives a dictionary.";
                                ];
                            };
                            conclude: null
                        };
                        _ -> {
                            ask (T is class:EvaluationError) out false else {
                                conclude: error [
                                    skill = "mapping_value_access";
                                    hypothesis = "inapplicable_assumed";
                                    RU.explanation = "к словарю обращаются по ключу неизменяемого типа, а здесь словарь типа ${X} и ключ типа ${I}. Следовательно, операция допустима.";
                                    EN.explanation = "a dictionary is accessed by a key of an immutable type, and here the dictionary has type ${X} and the key has type ${I}. Therefore, the operation is valid.";
                                    RU.reason = "${E.class()} не применяется к значениям этих типов.";
                                    EN.reason = "${E.class()} does not apply to values of these types.";
                                ];
                            };
                            conclude: null
                        };
                        correct -> { conclude: correct };
                        error -> { conclude: error };
                        null -> {
                            conclude: null [
                                skill = "mapping_value_access";
                                RU.explanation = "в словаре типа ${X} ни ключи, ни значения не имеют такого типа.";
                                EN.explanation = "neither the keys nor the values of the dictionary of type ${X} have this type.";
                            ]
                        };
                    } as mappingValueHypotheses
                };
                false -> {
                    ask (X is class:SequenceType and I is class:IntegerType) {
                        true -> {
                            ask (X is class:TupleType) {
                                true -> {
                                    var TT : TupleType = (X as class:TupleType);
                                    agg hyp {
                                        _ -> {
                                            ask (T == TT->itemType<Right.intValue>) out false else {
                                                conclude: correct [
                                                    skill = "indexed_element_type";
                                                    hypothesis = "rule";
                                                    RU.explanation = "элемент с индексом ${Right.intValue} в кортеже типа ${X} имеет этот тип.";
                                                    EN.explanation = "the element with index ${Right.intValue} in the tuple of type ${X} has this type.";
                                                ];
                                            };
                                            conclude: null
                                        };
                                        _ -> {
                                            ask (T == X) out false else {
                                                conclude: error [
                                                    skill = "indexed_element_type";
                                                    hypothesis = "container_type";
                                                    RU.explanation = "обращение по индексу берёт из кортежа один элемент, а не кортеж; часть кортежа даёт срез.";
                                                    EN.explanation = "indexing takes a single element out of the tuple, not a tuple; a part of the tuple is given by slicing.";
                                                    RU.reason = "Обращение к кортежу по индексу даёт кортеж.";
                                                    EN.reason = "Indexing a tuple gives a tuple.";
                                                ];
                                            };
                                            conclude: null
                                        };
                                        _ -> {
                                            ask (T == I) out false else {
                                                conclude: error [
                                                    skill = "indexed_element_type";
                                                    hypothesis = "index_type";
                                                    RU.explanation = "индекс лишь указывает позицию, а результат обращения — сам элемент кортежа.";
                                                    EN.explanation = "the index only points at a position; the result of indexing is the tuple element itself.";
                                                    RU.reason = "Обращение по индексу даёт тип индекса.";
                                                    EN.reason = "Indexing gives the type of the index.";
                                                ];
                                            };
                                            conclude: null
                                        };
                                        _ -> {
                                            ask (T is class:EvaluationError) out false else {
                                                conclude: error [
                                                    skill = "indexed_element_type";
                                                    hypothesis = "inapplicable_assumed";
                                                    RU.explanation = "к последовательности обращаются по целому индексу, а здесь последовательность типа ${X} и индекс типа ${I}. Следовательно, операция допустима.";
                                                    EN.explanation = "a sequence is accessed by an integer index, and here the sequence has type ${X} and the index has type ${I}. Therefore, the operation is valid.";
                                                    RU.reason = "${E.class()} не применяется к значениям этих типов.";
                                                    EN.reason = "${E.class()} does not apply to values of these types.";
                                                ];
                                            };
                                            conclude: null
                                        };
                                        correct -> { conclude: correct };
                                        error -> { conclude: error };
                                        null -> {
                                            conclude: null [
                                                skill = "indexed_element_type";
                                                RU.explanation = "элемент с индексом ${Right.intValue} в кортеже типа ${X} имеет другой тип.";
                                                EN.explanation = "the element with index ${Right.intValue} in the tuple of type ${X} has a different type.";
                                            ]
                                        };
                                    } as tupleElementHypotheses
                                };
                                false -> {
                                    var S : SequenceType = (X as class:SequenceType);
                                    agg hyp {
                                        _ -> {
                                            ask (T == S->elementType) out false else {
                                                conclude: correct [
                                                    skill = "indexed_element_type";
                                                    hypothesis = "rule";
                                                    RU.explanation = "обращение по индексу берёт один элемент из ${X}, а элементы там имеют тип ${S->elementType}.";
                                                    EN.explanation = "indexing takes a single element of ${X}, and its elements have type ${S->elementType}.";
                                                ];
                                            };
                                            conclude: null
                                        };
                                        _ -> {
                                            ask (T == X) out false else {
                                                conclude: error [
                                                    skill = "indexed_element_type";
                                                    hypothesis = "container_type";
                                                    RU.explanation = "обращение по индексу берёт из последовательности один элемент, а не последовательность; часть последовательности даёт срез.";
                                                    EN.explanation = "indexing takes a single element out of the sequence, not a sequence; a part of the sequence is given by slicing.";
                                                    RU.reason = "Обращение по индексу даёт последовательность того же типа.";
                                                    EN.reason = "Indexing gives a sequence of the same type.";
                                                ];
                                            };
                                            conclude: null
                                        };
                                        _ -> {
                                            ask (T == I) out false else {
                                                conclude: error [
                                                    skill = "indexed_element_type";
                                                    hypothesis = "index_type";
                                                    RU.explanation = "индекс лишь указывает позицию, а результат обращения — сам элемент последовательности.";
                                                    EN.explanation = "the index only points at a position; the result of indexing is the sequence element itself.";
                                                    RU.reason = "Обращение по индексу даёт тип индекса.";
                                                    EN.reason = "Indexing gives the type of the index.";
                                                ];
                                            };
                                            conclude: null
                                        };
                                        _ -> {
                                            ask (S->elementType is class:SequenceType and T == (S->elementType as class:SequenceType)->elementType) out false else {
                                                conclude: error [
                                                    skill = "indexed_element_type";
                                                    hypothesis = "nesting_level_skipped";
                                                    RU.explanation = "одно обращение по индексу достаёт элемент из ${X}, а не элемент этого элемента.";
                                                    EN.explanation = "one indexing takes an element of ${X}, not an element of that element.";
                                                    RU.reason = "Обращение по индексу доходит до самых внутренних элементов.";
                                                    EN.reason = "Indexing reaches the innermost elements.";
                                                ];
                                            };
                                            conclude: null
                                        };
                                        _ -> {
                                            ask (T is class:EvaluationError) out false else {
                                                conclude: error [
                                                    skill = "indexed_element_type";
                                                    hypothesis = "inapplicable_assumed";
                                                    RU.explanation = "к последовательности обращаются по целому индексу, а здесь последовательность типа ${X} и индекс типа ${I}. Следовательно, операция допустима.";
                                                    EN.explanation = "a sequence is accessed by an integer index, and here the sequence has type ${X} and the index has type ${I}. Therefore, the operation is valid.";
                                                    RU.reason = "${E.class()} не применяется к значениям этих типов.";
                                                    EN.reason = "${E.class()} does not apply to values of these types.";
                                                ];
                                            };
                                            conclude: null
                                        };
                                        correct -> { conclude: correct };
                                        error -> { conclude: error };
                                        null -> {
                                            conclude: null [
                                                skill = "indexed_element_type";
                                                RU.explanation = "в последовательности типа ${X} нет элементов такого типа.";
                                                EN.explanation = "a sequence of type ${X} has no elements of this type.";
                                            ]
                                        };
                                    } as sequenceElementHypotheses
                                };
                            } as tupleCheck
                        };
                        false -> {
                            agg hyp {
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: correct [
                                            skill = "indexing_applicability";
                                            hypothesis = "rule";
                                            RU.explanation = "к последовательности обращаются по целому индексу, а к словарю — по ключу неизменяемого типа; здесь же значение типа ${X} и индекс типа ${I}.";
                                            EN.explanation = "a sequence is indexed by an integer and a dictionary by a key of an immutable type, while here the value has type ${X} and the index has type ${I}.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (X is class:SequenceType and T == (X as class:SequenceType)->elementType
                                            or X is class:MappingType and T == (X as class:MappingType)->valueType) out false else {
                                        conclude: error [
                                            skill = "indexing_applicability";
                                            hypothesis = "index_type_ignored";
                                            RU.explanation = "${X is class:MappingType ? 'ключ словаря должен быть неизменяемого типа' : 'индекс последовательности должен быть целым числом'}, а здесь он типа ${I}.";
                                            EN.explanation = "${X is class:MappingType ? 'a dictionary key must be of an immutable type' : 'a sequence index must be an integer'}, while here it has type ${I}.";
                                            RU.reason = "Индекс может быть любого типа.";
                                            EN.reason = "An index can be of any type.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T == X) out false else {
                                        conclude: error [
                                            skill = "indexing_applicability";
                                            hypothesis = "container_type";
                                            RU.explanation = "к значению типа ${X} нельзя обратиться по индексу типа ${I}, и обращение не возвращает само значение.";
                                            EN.explanation = "a value of type ${X} cannot be indexed with an index of type ${I}, and indexing does not return the value itself.";
                                            RU.reason = "Результат берёт тип значения, к которому обращаются по индексу.";
                                            EN.reason = "The result takes the type of the indexed value.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T == I) out false else {
                                        conclude: error [
                                            skill = "indexing_applicability";
                                            hypothesis = "index_type";
                                            RU.explanation = "к значению типа ${X} нельзя обратиться по индексу типа ${I}, и индекс не становится результатом обращения.";
                                            EN.explanation = "a value of type ${X} cannot be indexed with an index of type ${I}, and the index does not become the result of indexing.";
                                            RU.reason = "Обращение по индексу даёт тип индекса.";
                                            EN.reason = "Indexing gives the type of the index.";
                                        ];
                                    };
                                    conclude: null
                                };
                                correct -> { conclude: correct };
                                error -> { conclude: error };
                                null -> {
                                    conclude: null [
                                        skill = "indexing_applicability";
                                        RU.explanation = "к значению типа ${X} нельзя обратиться по индексу типа ${I}.";
                                        EN.explanation = "a value of type ${X} cannot be indexed with an index of type ${I}.";
                                    ]
                                };
                            } as inapplicableIndexingHypotheses
                        };
                    } as sequenceIndexApplicability
                };
            } as mappingCheck
        };
        OperationGroup:slicing -> {
            var Left : Expr = leftOf(E, Old, New);
            var X : Type = (Left->hasType);

            // Срез кортежа даёт новый тип кортежа из части позиций; в модели такого вывода пока нет.
            ask (X is class:TupleType) out false else {
                conclude: null
            };
            ask (X is class:SequenceType) {
                true -> {
                    var S : SequenceType = (X as class:SequenceType);
                    agg hyp {
                        _ -> {
                            ask (T == X) out false else {
                                conclude: correct [
                                    skill = "slice_result";
                                    hypothesis = "rule";
                                    RU.explanation = "срез берёт часть последовательности ${X} и сохраняет её тип.";
                                    EN.explanation = "slicing takes a part of the sequence ${X} and keeps its type.";
                                ];
                            };
                            conclude: null
                        };
                        _ -> {
                            ask (T == S->elementType) out false else {
                                conclude: error [
                                    skill = "slice_result";
                                    hypothesis = "slice_as_index";
                                    RU.explanation = "срез берёт часть последовательности, а не один элемент; один элемент даёт обращение по индексу.";
                                    EN.explanation = "slicing takes a part of the sequence, not a single element; a single element is given by indexing.";
                                    RU.reason = "Срез даёт один элемент последовательности.";
                                    EN.reason = "Slicing gives a single element of the sequence.";
                                ];
                            };
                            conclude: null
                        };
                        _ -> {
                            ask (T is class:EvaluationError) out false else {
                                conclude: error [
                                    skill = "slice_result";
                                    hypothesis = "inapplicable_assumed";
                                    RU.explanation = "срез можно взять у любой последовательности, а значение типа ${X} — последовательность. Следовательно, операция допустима.";
                                    EN.explanation = "any sequence can be sliced, and a value of type ${X} is a sequence. Therefore, the operation is valid.";
                                    RU.reason = "${E.class()} не применяется к значению этого типа.";
                                    EN.reason = "${E.class()} does not apply to a value of this type.";
                                ];
                            };
                            conclude: null
                        };
                        correct -> { conclude: correct };
                        error -> { conclude: error };
                        null -> {
                            conclude: null [
                                skill = "slice_result";
                                RU.explanation = "срез не меняет тип последовательности ${X}.";
                                EN.explanation = "slicing does not change the type of the sequence ${X}.";
                            ]
                        };
                    }
                };
                false -> {
                    agg hyp {
                        _ -> {
                            ask (T is class:EvaluationError) out false else {
                                conclude: correct [
                                    skill = "slice_result";
                                    hypothesis = "rule";
                                    RU.explanation = "срез можно взять только у последовательности, а здесь значение типа ${X}.";
                                    EN.explanation = "only a sequence can be sliced, while here the value has type ${X}.";
                                ];
                            };
                            conclude: null
                        };
                        _ -> {
                            ask (T == X) out false else {
                                conclude: error [
                                    skill = "slice_result";
                                    hypothesis = "container_type";
                                    RU.explanation = "у значения типа ${X} нельзя взять срез, и оно само не может стать результатом.";
                                    EN.explanation = "a value of type ${X} cannot be sliced, and it cannot become the result itself.";
                                    RU.reason = "Результат берёт тип значения, у которого берут срез.";
                                    EN.reason = "The result takes the type of the sliced value.";
                                ];
                            };
                            conclude: null
                        };
                        correct -> { conclude: correct };
                        error -> { conclude: error };
                        null -> {
                            conclude: null [
                                skill = "slice_result";
                                RU.explanation = "у значения типа ${X} нельзя взять срез.";
                                EN.explanation = "a value of type ${X} cannot be sliced.";
                            ]
                        };
                    }
                };
            } as sliceApplicability
        };
        OperationGroup:call -> {
            var F : CallOperation = (E as class:CallOperation);

            ask (F.argumentRequirement) {
                ArgumentRequirement:none -> {
                    agg hyp {
                        _ -> {
                            ask (givesFixedResult(F, T)) out false else {
                                conclude: correct [
                                    skill = "call_fixed_result";
                                    hypothesis = "rule";
                                    RU.explanation = "${F.class()} всегда возвращает ${F.fixedResult == FixedResult:text ? 'строку' : 'число'}, что бы ни ввели.";
                                    EN.explanation = "the ${F.class()} always returns ${F.fixedResult == FixedResult:text ? 'a string' : 'a number'}, whatever is typed in.";
                                ];
                            };
                            conclude: null
                        };
                        _ -> {
                            ask (F.readsUserInput and isNumber(T)) out false else {
                                conclude: error [
                                    skill = "call_fixed_result";
                                    hypothesis = "input_returns_number";
                                    RU.explanation = "${F.class()} возвращает введённый текст как строку, даже если ввели цифры; чтобы получить число, строку нужно явно преобразовать.";
                                    EN.explanation = "the ${F.class()} returns the typed text as a string even if digits were typed; to get a number, the string has to be converted explicitly.";
                                    RU.reason = "${F.class()} возвращает число, если ввели цифры.";
                                    EN.reason = "The ${F.class()} returns a number if digits are typed in.";
                                ];
                            };
                            conclude: null
                        };
                        correct -> { conclude: correct };
                        error -> { conclude: error };
                        null -> {
                            conclude: null [
                                skill = "call_fixed_result";
                                RU.explanation = "${F.class()} всегда возвращает ${F.fixedResult == FixedResult:text ? 'строку' : 'число'}, что бы ни ввели.";
                                EN.explanation = "the ${F.class()} always returns ${F.fixedResult == FixedResult:text ? 'a string' : 'a number'}, whatever is typed in.";
                            ]
                        };
                    }
                };
                ArgumentRequirement:any -> {
                    var Left : Expr = leftOf(E, Old, New);
                    var A : Type = (Left->hasType);
                    agg hyp {
                        _ -> {
                            ask (givesFixedResult(F, T)) out false else {
                                conclude: correct [
                                    skill = "call_fixed_result";
                                    hypothesis = "rule";
                                    RU.explanation = "${F.class()} преобразует аргумент любого типа в ${F.fixedResult == FixedResult:text ? 'строку' : 'число'}.";
                                    EN.explanation = "the ${F.class()} converts an argument of any type into ${F.fixedResult == FixedResult:text ? 'a string' : 'a number'}.";
                                ];
                            };
                            conclude: null
                        };
                        _ -> {
                            ask (T == A) out false else {
                                conclude: error [
                                    skill = "call_fixed_result";
                                    hypothesis = "argument_type";
                                    RU.explanation = "${F.class()} не возвращает аргумент как есть, а создаёт из него новое значение.";
                                    EN.explanation = "the ${F.class()} does not return its argument as is; it creates a new value from it.";
                                    RU.reason = "Результат берёт тип аргумента.";
                                    EN.reason = "The result takes the type of the argument.";
                                ];
                            };
                            conclude: null
                        };
                        _ -> {
                            ask (T is class:EvaluationError) out false else {
                                conclude: error [
                                    skill = "call_fixed_result";
                                    hypothesis = "inapplicable_assumed";
                                    RU.explanation = "${F.class()} принимает аргумент любого типа. Следовательно, операция допустима.";
                                    EN.explanation = "the ${F.class()} accepts an argument of any type. Therefore, the operation is valid.";
                                    RU.reason = "${F.class()} не применяется к аргументу этого типа.";
                                    EN.reason = "The ${F.class()} does not apply to an argument of this type.";
                                ];
                            };
                            conclude: null
                        };
                        correct -> { conclude: correct };
                        error -> { conclude: error };
                        null -> {
                            conclude: null [
                                skill = "call_fixed_result";
                                RU.explanation = "${F.class()} для аргумента любого типа возвращает ${F.fixedResult == FixedResult:text ? 'строку' : 'число'}.";
                                EN.explanation = "the ${F.class()} returns ${F.fixedResult == FixedResult:text ? 'a string' : 'a number'} for an argument of any type.";
                            ]
                        };
                    }
                };
                ArgumentRequirement:sized -> {
                    var Left : Expr = leftOf(E, Old, New);
                    var A : Type = (Left->hasType);
                    ask (A is class:SequenceType or A is class:MappingType) {
                        true -> {
                            agg hyp {
                                _ -> {
                                    ask (givesFixedResult(F, T)) out false else {
                                        conclude: correct [
                                            skill = "length_applicability";
                                            hypothesis = "rule";
                                            RU.explanation = "${F.class()} считает элементы в значении типа ${A} и возвращает их количество — целое число.";
                                            EN.explanation = "the ${F.class()} counts the elements of a value of type ${A} and returns their number, an integer.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T == A) out false else {
                                        conclude: error [
                                            skill = "length_applicability";
                                            hypothesis = "argument_type";
                                            RU.explanation = "${F.class()} не возвращает свой аргумент, а считает в нём элементы.";
                                            EN.explanation = "the ${F.class()} does not return its argument; it counts its elements.";
                                            RU.reason = "Результат берёт тип аргумента.";
                                            EN.reason = "The result takes the type of the argument.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: error [
                                            skill = "length_applicability";
                                            hypothesis = "inapplicable_assumed";
                                            RU.explanation = "у значения типа ${A} есть элементы, и ${F.class()} их считает. Следовательно, операция допустима.";
                                            EN.explanation = "a value of type ${A} has elements, and the ${F.class()} counts them. Therefore, the operation is valid.";
                                            RU.reason = "${F.class()} не применяется к аргументу этого типа.";
                                            EN.reason = "The ${F.class()} does not apply to an argument of this type.";
                                        ];
                                    };
                                    conclude: null
                                };
                                correct -> { conclude: correct };
                                error -> { conclude: error };
                                null -> {
                                    conclude: null [
                                        skill = "length_applicability";
                                        RU.explanation = "${F.class()} возвращает количество элементов в значении типа ${A}, а не значение такого типа.";
                                        EN.explanation = "the ${F.class()} returns the number of elements of a value of type ${A}, not a value of this type.";
                                    ]
                                };
                            }
                        };
                        false -> {
                            agg hyp {
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: correct [
                                            skill = "length_applicability";
                                            hypothesis = "rule";
                                            RU.explanation = "у значения типа ${A} нет элементов, которые можно было бы посчитать.";
                                            EN.explanation = "a value of type ${A} has no elements that could be counted.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (givesFixedResult(F, T)) out false else {
                                        conclude: error [
                                            skill = "length_applicability";
                                            hypothesis = "inapplicable_call_gives_result";
                                            RU.explanation = "у значения типа ${A} нет элементов, которые можно было бы посчитать.";
                                            EN.explanation = "a value of type ${A} has no elements that could be counted.";
                                            RU.reason = "Подсчёт элементов всегда даёт целое число.";
                                            EN.reason = "Counting elements always gives an integer.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T == A) out false else {
                                        conclude: error [
                                            skill = "length_applicability";
                                            hypothesis = "argument_type";
                                            RU.explanation = "у значения типа ${A} нет элементов, которые можно было бы посчитать, а свой аргумент ${F.class()} не возвращает.";
                                            EN.explanation = "a value of type ${A} has no elements that could be counted, and the ${F.class()} does not return its argument.";
                                            RU.reason = "Результат берёт тип аргумента.";
                                            EN.reason = "The result takes the type of the argument.";
                                        ];
                                    };
                                    conclude: null
                                };
                                correct -> { conclude: correct };
                                error -> { conclude: error };
                                null -> {
                                    conclude: null [
                                        skill = "length_applicability";
                                        RU.explanation = "у значения типа ${A} нет длины.";
                                        EN.explanation = "a value of type ${A} has no length.";
                                    ]
                                };
                            } as inapplicableLengthHypotheses
                        };
                    } as sizedArgumentCheck
                };
                ArgumentRequirement:numberOrText -> {
                    var Left : Expr = leftOf(E, Old, New);
                    var A : Type = (Left->hasType);
                    ask (A.isArithmetic or A is class:TextType) {
                        true -> {
                            agg hyp {
                                _ -> {
                                    ask (givesFixedResult(F, T)) out false else {
                                        conclude: correct [
                                            skill = "conversion_applicability";
                                            hypothesis = "rule";
                                            RU.explanation = "${F.class()} преобразует значение типа ${A} в значение своего типа.";
                                            EN.explanation = "the ${F.class()} converts a value of type ${A} into a value of its own type.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T == A) out false else {
                                        conclude: error [
                                            skill = "conversion_applicability";
                                            hypothesis = "argument_type";
                                            RU.explanation = "${F.class()} не возвращает аргумент как есть, а преобразует его.";
                                            EN.explanation = "the ${F.class()} does not return its argument as is; it converts it.";
                                            RU.reason = "Результат берёт тип аргумента.";
                                            EN.reason = "The result takes the type of the argument.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: error [
                                            skill = "conversion_applicability";
                                            hypothesis = "inapplicable_assumed";
                                            RU.explanation = "в число преобразуются числа и строки, а здесь аргумент типа ${A}. Следовательно, операция допустима.";
                                            EN.explanation = "numbers and strings can be converted to a number, and here the argument has type ${A}. Therefore, the operation is valid.";
                                            RU.reason = "${F.class()} не применяется к аргументу этого типа.";
                                            EN.reason = "The ${F.class()} does not apply to an argument of this type.";
                                        ];
                                    };
                                    conclude: null
                                };
                                correct -> { conclude: correct };
                                error -> { conclude: error };
                                null -> {
                                    conclude: null [
                                        skill = "conversion_applicability";
                                        RU.explanation = "${F.class()} преобразует аргумент в значение своего типа, и этот тип не зависит от аргумента.";
                                        EN.explanation = "the ${F.class()} converts its argument into a value of its own type, and that type does not depend on the argument.";
                                    ]
                                };
                            }
                        };
                        false -> {
                            agg hyp {
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: correct [
                                            skill = "conversion_applicability";
                                            hypothesis = "rule";
                                            RU.explanation = "в число преобразуются только числа и строки, а здесь аргумент типа ${A}.";
                                            EN.explanation = "only numbers and strings can be converted to a number, while here the argument has type ${A}.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (givesFixedResult(F, T)) out false else {
                                        conclude: error [
                                            skill = "conversion_applicability";
                                            hypothesis = "inapplicable_call_gives_result";
                                            RU.explanation = "в число преобразуются только числа и строки, а здесь аргумент типа ${A}.";
                                            EN.explanation = "only numbers and strings can be converted to a number, while here the argument has type ${A}.";
                                            RU.reason = "Преобразование всегда даёт значение нужного типа.";
                                            EN.reason = "A conversion always gives a value of the target type.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T == A) out false else {
                                        conclude: error [
                                            skill = "conversion_applicability";
                                            hypothesis = "argument_type";
                                            RU.explanation = "в число преобразуются только числа и строки, а здесь аргумент типа ${A}; свой аргумент ${F.class()} тоже не возвращает.";
                                            EN.explanation = "only numbers and strings can be converted to a number, while here the argument has type ${A}; the ${F.class()} does not return its argument either.";
                                            RU.reason = "Результат берёт тип аргумента.";
                                            EN.reason = "The result takes the type of the argument.";
                                        ];
                                    };
                                    conclude: null
                                };
                                correct -> { conclude: correct };
                                error -> { conclude: error };
                                null -> {
                                    conclude: null [
                                        skill = "conversion_applicability";
                                        RU.explanation = "значение типа ${A} нельзя преобразовать в число.";
                                        EN.explanation = "a value of type ${A} cannot be converted to a number.";
                                    ]
                                };
                            } as inapplicableConversionHypotheses
                        };
                    } as convertibleArgumentCheck
                };
            } as argumentRequirementSwitch
        };
    } as operationGroup
}
[
    RU.error_prefix = "Выражение ${E} ${T is class:EvaluationError ? 'не может вызвать ошибку' : 'не может иметь тип'} ${T}, потому что ";
    EN.error_prefix = "The expression ${E} ${T is class:EvaluationError ? 'cannot cause the error' : 'cannot have the type'} ${T} because ";
    RU.hint_prefix = "Выражение ${E} ${T is class:EvaluationError ? 'вызывает ошибку' : 'имеет тип'} ${T}, потому что ";
    EN.hint_prefix = "The expression ${E} ${T is class:EvaluationError ? 'causes the error' : 'has the type'} ${T} because ";
    RU.misreasoning_prefix = "Выражение ${E} действительно ${T is class:EvaluationError ? 'вызывает ошибку' : 'имеет тип'} ${T}, но рассуждение ошибочно: ";
    EN.misreasoning_prefix = "The expression ${E} does ${T is class:EvaluationError ? 'cause the error' : 'have the type'} ${T}, but the reasoning is wrong: ";
    RU.error_statement = "Выражение ${E} ${T is class:EvaluationError ? 'не может вызвать ошибку' : 'не может иметь тип'} ${T}.";
    EN.error_statement = "The expression ${E} ${T is class:EvaluationError ? 'cannot cause the error' : 'cannot have the type'} ${T}.";
]

// Навык — последняя развилка перед выводом correct/error, у которой к таким выводам ведут хотя бы два выхода.
meta for numericOperands [
    skill = "numeric_result_type";
]
meta for sequenceApplicability [
    skill = "sequence_operation_applicability";
]
meta for negationCheck [
    skill = "negation_result";
]
meta for logicalResultKind [
    skill = "boolean_logical_result";
]
meta for returnedOperand [
    skill = "logical_returned_operand";
]
meta for equalityApplicability [
    skill = "equality_comparison";
]
meta for orderingApplicability [
    skill = "ordering_comparison";
]
meta for membershipApplicability [
    skill = "membership_test";
]
meta for mappingCheck [
    skill = "mapping_value_access";
]
meta for sequenceIndexApplicability [
    skill = "indexing_applicability";
]
meta for tupleCheck [
    skill = "indexed_element_type";
]
meta for sliceApplicability [
    skill = "slice_result";
]
meta for argumentRequirementSwitch [
    skill = "call_fixed_result";
]
meta for sizedArgumentCheck [
    skill = "length_applicability";
]
meta for convertibleArgumentCheck [
    skill = "conversion_applicability";
]
