// Тип операции E, в которой операнд Old прочитан как New (Old == New == E — выражение как написано).
// Каждая ветвь правила типизации заканчивается hyp по способам рассуждения студента: ветвь сравнивает ответ T
// со своим выводом и даёт null, если этот способ к T не приводит. Все ветви одного hyp — под одной развилкой,
// поэтому гипотезы различаются объяснением, но не навыком. Если ответ не объяснил ни один способ, дерево даёт null:
// ошибкой его делает основное дерево, когда и прочтения выражения его не объяснили.
// TODO: верный ответ, к которому ведёт и ошибочная гипотеза, hyp засчитывает как верный; уточнять такие случаи
//  вопросом — ценная метрика для эксперимента (открытый вопрос: какой вес гипотезы считать высоким).

lambda leftOf(E: Operation, Old: Expr, New: Expr) = E->hasOperand<OperandPlacement:left> == Old ? New : E->hasOperand<OperandPlacement:left>;

lambda rightOf(E: Operation, Old: Expr, New: Expr) = E->hasOperand<OperandPlacement:right> == Old ? New : E->hasOperand<OperandPlacement:right>;

lambda maxOf(a: int, b: int) = a > b ? a : b;

lambda orderable(L: Type, R: Type) = L.isArithmetic and R.isArithmetic or L is class:SequenceType and L.class() == R.class();

// Ответ может быть ошибкой, а свойства чисел есть только у типов.
lambda isNumber(T: Outcome) = T is class:Type and (T as class:Type).isArithmetic;

lambda isNumberOfRank(T: Outcome, rank: int) = isNumber(T) and (T as class:Type).conversionRank == rank;

lambda givesFixedResult(F: CallOperation, T: Outcome) = F.fixedResult == FixedResult:text and T is class:TextType or F.fixedResult == FixedResult:number and isNumberOfRank(T, F.resultRank);

tpg Typed(E: Operation, Old: Expr, New: Expr, T: Outcome) {
    ask (E.group) {
        OperationGroup:arithmetic -> {
            var A : ArithmeticOperation = (E as class:ArithmeticOperation);
            var Left : Expr = leftOf(E, Old, New);
            var Right : Expr = rightOf(E, Old, New);
            var L : Type = (Left->hasType);
            var R : Type = (Right->hasType);

            ask (L.isArithmetic and R.isArithmetic) {
                true -> {
                    // Числа: студент посчитал результат — верно или с заблуждениями о делении и типе результата — или
                    // решил, что операция к числам неприменима.
                    agg hyp {
                        _ -> {
                            conclude: subcall("numeric_result", E, L, R, T)
                        };
                        _ -> {
                            ask (T is class:EvaluationError) out false else {
                                conclude: error [
                                    skill = "numeric_result_type";
                                    hypothesis = "inapplicable_assumed";
                                    RU.explanation = "${A.class()} применяется к числам, а оба операнда — числа: ${L} и ${R}. Следовательно, операция допустима.";
                                    EN.explanation = "the ${A.class()} applies to numbers, and both operands are numbers: ${L} and ${R}. Therefore, the operation is valid.";
                                    RU.reason = "${A.class()} не применяется к операндам этих типов.";
                                    EN.reason = "The ${A.class()} does not apply to operands of these types.";
                                ];
                            };
                            conclude: null
                        };
                        correct -> { conclude: correct };
                        error -> { conclude: error };
                        null -> { conclude: null };
                    }
                };
                false -> {
                    // Одна развилка с тремя исходами, а не цепочка проверок: иначе навык неприменимой операции
                    // достался бы последней проверке в цепочке.
                    ask ((A.concatenatesSequences and L is class:SequenceType and L == R)
                            ? SequenceUse:concatenation
                            : ((A.repeatsSequence and (L is class:SequenceType and R is class:IntegerType or L is class:IntegerType and R is class:SequenceType))
                                ? SequenceUse:repetition
                                : SequenceUse:inapplicable)) {
                        SequenceUse:concatenation -> {
                            agg hyp {
                                _ -> {
                                    ask (T == L) out false else {
                                        conclude: correct [
                                            skill = "sequence_operation_applicability";
                                            hypothesis = "rule";
                                            RU.explanation = "${A.class()} склеивает две последовательности одного типа (${L}), и тип при этом сохраняется.";
                                            EN.explanation = "the ${A.class()} concatenates two sequences of the same type (${L}), and the type is kept.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T is class:IntegerType and Left.isNumericText and Right.isNumericText) out false else {
                                        conclude: error [
                                            skill = "sequence_operation_applicability";
                                            hypothesis = "numeric_text_addition";
                                            RU.explanation = "оба операнда — строки, пусть и похожие на числа, а ${A.class()} строки склеивает, а не складывает как числа.";
                                            EN.explanation = "both operands are strings, even though they look like numbers, and the ${A.class()} concatenates strings instead of adding them as numbers.";
                                            RU.reason = "Строки из цифр складываются как числа.";
                                            EN.reason = "Strings of digits are added as numbers.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: error [
                                            skill = "sequence_operation_applicability";
                                            hypothesis = "inapplicable_assumed";
                                            RU.explanation = "${A.class()} соединяет последовательности одного вида, а оба операнда имеют тип ${L}. Следовательно, операция допустима.";
                                            EN.explanation = "the ${A.class()} joins sequences of the same kind, and both operands have type ${L}. Therefore, the operation is valid.";
                                            RU.reason = "${A.class()} не соединяет последовательности.";
                                            EN.reason = "The ${A.class()} does not join sequences.";
                                        ];
                                    };
                                    conclude: null
                                };
                                correct -> { conclude: correct };
                                error -> { conclude: error };
                                null -> {
                                    conclude: null [
                                        skill = "sequence_operation_applicability";
                                        RU.explanation = "ни у одного из операндов (${L}, ${R}) нет такого типа, и ${A.class()} его не создаёт.";
                                        EN.explanation = "neither operand (${L}, ${R}) has this type, and the ${A.class()} does not create it.";
                                    ]
                                };
                            }
                        };
                        SequenceUse:repetition -> {
                            agg hyp {
                                _ -> {
                                    ask (T == (L is class:SequenceType ? L : R)) out false else {
                                        conclude: correct [
                                            skill = "sequence_operation_applicability";
                                            hypothesis = "rule";
                                            RU.explanation = "умножение последовательности на целое число повторяет её, и тип последовательности сохраняется.";
                                            EN.explanation = "multiplying a sequence by an integer repeats it, and the sequence type is kept.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T == L or T == R) out false else {
                                        conclude: error [
                                            skill = "sequence_operation_applicability";
                                            hypothesis = "operand_type";
                                            RU.explanation = "${A.class()} между последовательностью и целым числом повторяет последовательность, а не перемножает числа.";
                                            EN.explanation = "the ${A.class()} between a sequence and an integer repeats the sequence instead of multiplying numbers.";
                                            RU.reason = "Результат берёт тип одного из операндов.";
                                            EN.reason = "The result takes the type of one of the operands.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: error [
                                            skill = "sequence_operation_applicability";
                                            hypothesis = "inapplicable_assumed";
                                            RU.explanation = "умножение последовательности на целое число повторяет её. Следовательно, операция допустима.";
                                            EN.explanation = "multiplying a sequence by an integer repeats it. Therefore, the operation is valid.";
                                            RU.reason = "Последовательность нельзя умножить на число.";
                                            EN.reason = "A sequence cannot be multiplied by a number.";
                                        ];
                                    };
                                    conclude: null
                                };
                                correct -> { conclude: correct };
                                error -> { conclude: error };
                                null -> {
                                    conclude: null [
                                        skill = "sequence_operation_applicability";
                                        RU.explanation = "ни у одного из операндов (${L}, ${R}) нет такого типа, и ${A.class()} его не создаёт.";
                                        EN.explanation = "neither operand (${L}, ${R}) has this type, and the ${A.class()} does not create it.";
                                    ]
                                };
                            } as repetitionHypotheses
                        };
                        SequenceUse:inapplicable -> {
                            agg hyp {
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: correct [
                                            skill = "sequence_operation_applicability";
                                            hypothesis = "rule";
                                            RU.explanation = "${A.class()} нельзя применить к операндам типов ${L} и ${R}.";
                                            EN.explanation = "the ${A.class()} cannot be applied to operands of types ${L} and ${R}.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T == L or T == R) out false else {
                                        conclude: error [
                                            skill = "sequence_operation_applicability";
                                            hypothesis = "operand_type";
                                            RU.explanation = "${A.class()} нельзя применить к операндам типов ${L} и ${R}, и ни один из операндов не может стать его результатом.";
                                            EN.explanation = "the ${A.class()} cannot be applied to operands of types ${L} and ${R}, and neither operand can become its result.";
                                            RU.reason = "Результат берёт тип одного из операндов.";
                                            EN.reason = "The result takes the type of one of the operands.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (A.concatenatesSequences and T is class:TextType and (L is class:TextType and R.isArithmetic or L.isArithmetic and R is class:TextType)) out false else {
                                        conclude: error [
                                            skill = "sequence_operation_applicability";
                                            hypothesis = "implicit_text_conversion";
                                            RU.explanation = "${A.class()} сам не превращает число в строку: склеить их можно только после явного преобразования числа в строку.";
                                            EN.explanation = "the ${A.class()} does not turn a number into a string by itself: they can be joined only after an explicit conversion of the number to a string.";
                                            RU.reason = "При сложении со строкой число само превращается в строку.";
                                            EN.reason = "When added to a string, a number turns into a string by itself.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (A.concatenatesSequences and L is class:ListType and (L as class:ListType)->elementType == R and T == L) out false else {
                                        conclude: error [
                                            skill = "sequence_operation_applicability";
                                            hypothesis = "element_appended";
                                            RU.explanation = "${A.class()} соединяет два списка и не добавляет к списку ${L} отдельный элемент типа ${R}.";
                                            EN.explanation = "the ${A.class()} joins two lists and does not add a single element of type ${R} to a list ${L}.";
                                            RU.reason = "${A.class()} добавляет элемент в конец списка.";
                                            EN.reason = "The ${A.class()} adds an element to the end of a list.";
                                        ];
                                    };
                                    conclude: null
                                };
                                correct -> { conclude: correct };
                                error -> { conclude: error };
                                null -> {
                                    conclude: null [
                                        skill = "sequence_operation_applicability";
                                        RU.explanation = "${A.class()} нельзя применить к операндам типов ${L} и ${R}.";
                                        EN.explanation = "the ${A.class()} cannot be applied to operands of types ${L} and ${R}.";
                                    ]
                                };
                            } as inapplicableSequenceOperationHypotheses
                        };
                    } as sequenceApplicability
                };
            } as numericOperands
        };
        OperationGroup:logical -> {
            var Left : Expr = leftOf(E, Old, New);
            var L : Type = (Left->hasType);

            ask (E is class:NegationOperation) {
                true -> {
                    agg hyp {
                        _ -> {
                            ask (T is class:BooleanType) out false else {
                                conclude: correct [
                                    skill = "negation_result";
                                    hypothesis = "rule";
                                    RU.explanation = "${E.class()} лишь сообщает, ложен ли операнд, и отвечает логическим значением.";
                                    EN.explanation = "the ${E.class()} only tells whether the operand is falsy and answers with a boolean.";
                                ];
                            };
                            conclude: null
                        };
                        _ -> {
                            ask (T == L) out false else {
                                conclude: error [
                                    skill = "negation_result";
                                    hypothesis = "operand_type";
                                    RU.explanation = "${E.class()} не возвращает свой операнд, а лишь сообщает, ложен ли он.";
                                    EN.explanation = "the ${E.class()} does not return its operand; it only tells whether the operand is falsy.";
                                    RU.reason = "Результат берёт тип операнда.";
                                    EN.reason = "The result takes the type of the operand.";
                                ];
                            };
                            conclude: null
                        };
                        _ -> {
                            ask (T is class:EvaluationError) out false else {
                                conclude: error [
                                    skill = "negation_result";
                                    hypothesis = "inapplicable_assumed";
                                    RU.explanation = "${E.class()} применяется к значению любого типа: у каждого значения есть истинность. Следовательно, операция допустима.";
                                    EN.explanation = "the ${E.class()} applies to a value of any type: every value is either truthy or falsy. Therefore, the operation is valid.";
                                    RU.reason = "${E.class()} не применяется к операнду этого типа.";
                                    EN.reason = "The ${E.class()} does not apply to an operand of this type.";
                                ];
                            };
                            conclude: null
                        };
                        correct -> { conclude: correct };
                        error -> { conclude: error };
                        null -> {
                            conclude: null [
                                skill = "negation_result";
                                RU.explanation = "${E.class()} лишь сообщает, ложен ли операнд, и не создаёт значений такого типа.";
                                EN.explanation = "the ${E.class()} only tells whether the operand is falsy and does not create values of this type.";
                            ]
                        };
                    }
                };
                false -> {
                    var B : LogicalOperation = (E as class:LogicalOperation);
                    var Right : Expr = rightOf(E, Old, New);
                    var R : Type = (Right->hasType);

                    ask (B.returnsOperand) {
                        false -> {
                            agg hyp {
                                _ -> {
                                    ask (T is class:BooleanType) out false else {
                                        conclude: correct [
                                            skill = "boolean_logical_result";
                                            hypothesis = "rule";
                                            RU.explanation = "в этом языке ${B.class()} вычисляет истинность всего выражения и отвечает логическим значением.";
                                            EN.explanation = "in this language the ${B.class()} evaluates the truth of the whole expression and answers with a boolean.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T == L or T == R) out false else {
                                        conclude: error [
                                            skill = "boolean_logical_result";
                                            hypothesis = "operand_type";
                                            RU.explanation = "в этом языке ${B.class()} не возвращает операнд, а вычисляет истинность всего выражения.";
                                            EN.explanation = "in this language the ${B.class()} does not return an operand; it evaluates the truth of the whole expression.";
                                            RU.reason = "Результат берёт тип одного из операндов.";
                                            EN.reason = "The result takes the type of one of the operands.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: error [
                                            skill = "boolean_logical_result";
                                            hypothesis = "inapplicable_assumed";
                                            RU.explanation = "${B.class()} применяется к значениям любых типов: у каждого значения есть истинность. Следовательно, операция допустима.";
                                            EN.explanation = "the ${B.class()} applies to values of any types: every value is either truthy or falsy. Therefore, the operation is valid.";
                                            RU.reason = "${B.class()} не применяется к операндам этих типов.";
                                            EN.reason = "The ${B.class()} does not apply to operands of these types.";
                                        ];
                                    };
                                    conclude: null
                                };
                                correct -> { conclude: correct };
                                error -> { conclude: error };
                                null -> {
                                    conclude: null [
                                        skill = "boolean_logical_result";
                                        RU.explanation = "в этом языке ${B.class()} вычисляет только истинность выражения и не создаёт значений такого типа.";
                                        EN.explanation = "in this language the ${B.class()} only evaluates the truth of the expression and does not create values of this type.";
                                    ]
                                };
                            }
                        };
                        true -> {
                            // Какой операнд вернётся, решают два решения студента: истинен ли левый операнд и на каком
                            // операнде останавливается операция. Ошибка в одном из них даёт другой операнд, в обоих — снова верный.
                            var Returned : Expr = (Left.isTruthy == B.returnsLeftWhenLeftTruthy) ? Left : Right;
                            var Other : Expr = (Left.isTruthy == B.returnsLeftWhenLeftTruthy) ? Right : Left;
                            agg hyp {
                                _ -> {
                                    conclude: subcall("returned_operand", E, Left, Returned, Other, T)
                                };
                                _ -> {
                                    agg and {
                                        _ -> {
                                            conclude: error [
                                                skill = "logical_returned_operand";
                                                hypothesis = "truthiness_misjudged";
                                                RU.explanation = "левый операнд ${Left.isTruthy ? 'истинный' : 'ложный'}, а ${B.class()} на таком операнде ${Returned == Left ? 'останавливается' : 'не останавливается'}.";
                                                EN.explanation = "the left operand is ${Left.isTruthy ? 'truthy' : 'falsy'}, and the ${B.class()} ${Returned == Left ? 'stops' : 'does not stop'} at such an operand.";
                                                RU.reason = "Левый операнд ${Left.isTruthy ? 'ложный' : 'истинный'}.";
                                                EN.reason = "The left operand is ${Left.isTruthy ? 'falsy' : 'truthy'}.";
                                            ]
                                        };
                                        _ -> {
                                            conclude: subcall("returned_operand", E, Left, Other, Returned, T)
                                        };
                                        correct -> { conclude: correct };
                                        error -> { conclude: error };
                                        null -> { conclude: null };
                                    }
                                };
                                _ -> {
                                    ask (T is class:BooleanType) out false else {
                                        conclude: error [
                                            skill = "logical_returned_operand";
                                            hypothesis = "logical_gives_boolean";
                                            RU.explanation = "${B.class()} не превращает результат в логическое значение — он возвращает один из операндов как есть.";
                                            EN.explanation = "the ${B.class()} does not turn the result into a boolean — it returns one of the operands as is.";
                                            RU.reason = "Логические операции всегда дают логическое значение.";
                                            EN.reason = "Logical operations always give a boolean.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: error [
                                            skill = "logical_returned_operand";
                                            hypothesis = "inapplicable_assumed";
                                            RU.explanation = "${B.class()} применяется к значениям любых типов: у каждого значения есть истинность. Следовательно, операция допустима.";
                                            EN.explanation = "the ${B.class()} applies to values of any types: every value is either truthy or falsy. Therefore, the operation is valid.";
                                            RU.reason = "${B.class()} не применяется к операндам этих типов.";
                                            EN.reason = "The ${B.class()} does not apply to operands of these types.";
                                        ];
                                    };
                                    conclude: null
                                };
                                correct -> { conclude: correct };
                                error -> { conclude: error };
                                null -> {
                                    conclude: null [
                                        skill = "logical_returned_operand";
                                        RU.explanation = "${B.class()} возвращает один из своих операндов, а ни один из них (${L}, ${R}) не имеет такого типа.";
                                        EN.explanation = "the ${B.class()} returns one of its operands, and neither of them (${L}, ${R}) has this type.";
                                    ]
                                };
                            } as returnedOperand
                        };
                    } as logicalResultKind
                };
            } as negationCheck
        };
        OperationGroup:comparison -> {
            var C : ComparisonOperation = (E as class:ComparisonOperation);
            var Left : Expr = leftOf(E, Old, New);
            var Right : Expr = rightOf(E, Old, New);
            var L : Type = (Left->hasType);
            var R : Type = (Right->hasType);

            ask (C.comparisonKind) {
                ComparisonKind:equality -> {
                    ask (C.comparesAnyTypes or orderable(L, R)) {
                        true -> {
                            agg hyp {
                                _ -> {
                                    ask (T is class:BooleanType) out false else {
                                        conclude: correct [
                                            skill = "equality_comparison";
                                            hypothesis = "rule";
                                            RU.explanation = "${C.class()} сравнивает значения и отвечает логическим значением.";
                                            EN.explanation = "the ${C.class()} compares the values and answers with a boolean.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T == L or T == R) out false else {
                                        conclude: error [
                                            skill = "equality_comparison";
                                            hypothesis = "operand_type";
                                            RU.explanation = "${C.class()} не возвращает сравниваемые значения, а только сообщает результат сравнения.";
                                            EN.explanation = "the ${C.class()} does not return the compared values; it only reports the result of the comparison.";
                                            RU.reason = "Результат берёт тип одного из операндов.";
                                            EN.reason = "The result takes the type of one of the operands.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: error [
                                            skill = "equality_comparison";
                                            hypothesis = "inapplicable_assumed";
                                            RU.explanation = "${C.comparesAnyTypes ? 'на равенство можно сравнивать значения любых типов' : 'на равенство можно сравнивать числа между собой и последовательности одного вида'}. Следовательно, операция допустима.";
                                            EN.explanation = "${C.comparesAnyTypes ? 'values of any types can be compared for equality' : 'numbers with numbers and sequences of the same kind can be compared for equality'}. Therefore, the operation is valid.";
                                            RU.reason = "${C.class()} не применяется к значениям этих типов.";
                                            EN.reason = "The ${C.class()} does not apply to values of these types.";
                                        ];
                                    };
                                    conclude: null
                                };
                                correct -> { conclude: correct };
                                error -> { conclude: error };
                                null -> {
                                    conclude: null [
                                        skill = "equality_comparison";
                                        RU.explanation = "${C.class()} сообщает только результат сравнения и не создаёт значений такого типа.";
                                        EN.explanation = "the ${C.class()} only reports the result of the comparison and does not create values of this type.";
                                    ]
                                };
                            }
                        };
                        false -> {
                            agg hyp {
                                _ -> {
                                    ask (T is class:EvaluationError) out false else {
                                        conclude: correct [
                                            skill = "equality_comparison";
                                            hypothesis = "rule";
                                            RU.explanation = "${C.class()} не применим к значениям типов ${L} и ${R}.";
                                            EN.explanation = "the ${C.class()} cannot be applied to values of types ${L} and ${R}.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T is class:BooleanType) out false else {
                                        conclude: error [
                                            skill = "equality_comparison";
                                            hypothesis = "inapplicable_comparison_gives_boolean";
                                            RU.explanation = "${C.class()} не применим к значениям типов ${L} и ${R}, поэтому сравнение не дойдёт до логического значения.";
                                            EN.explanation = "the ${C.class()} cannot be applied to values of types ${L} and ${R}, so the comparison never gets to a boolean.";
                                            RU.reason = "Проверка на равенство всегда даёт логическое значение.";
                                            EN.reason = "An equality check always gives a boolean.";
                                        ];
                                    };
                                    conclude: null
                                };
                                _ -> {
                                    ask (T == L or T == R) out false else {
                                        conclude: error [
                                            skill = "equality_comparison";
                                            hypothesis = "operand_type";
                                            RU.explanation = "${C.class()} не применим к значениям типов ${L} и ${R}, а сравнение и не возвращает свои операнды.";
                                            EN.explanation = "the ${C.class()} cannot be applied to values of types ${L} and ${R}, and a comparison does not return its operands anyway.";
                                            RU.reason = "Результат берёт тип одного из операндов.";
                                            EN.reason = "The result takes the type of one of the operands.";
                                        ];
