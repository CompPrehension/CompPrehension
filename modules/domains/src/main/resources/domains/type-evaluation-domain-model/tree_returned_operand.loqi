// Какой операнд вернёт and/or при уже решённой истинности левого операнда: Returned — тот, что вернётся, если студент
// верно знает, на каком операнде операция останавливается, Other — другой.

// Студент считает, что вернётся операнд X.
fragment operandReturned(X: Expr) {
    ask (T == X->hasType) out false else {
        conclude: correct [
            skill = "logical_returned_operand";
            hypothesis = "rule";
            RU.explanation = "левый операнд ${Left.isTruthy ? 'истинный' : 'ложный'}, ${X == Left ? 'а ' : ''}${B.class()} на таком операнде ${X == Left ? 'останавливается и возвращает его' : 'не останавливается и возвращает правый операнд'}.";
            EN.explanation = "the left operand is ${Left.isTruthy ? 'truthy' : 'falsy'}, ${X == Left ? 'and the' : 'so the'} ${B.class()} ${X == Left ? 'stops at such an operand and returns it' : 'does not stop at it and returns the right operand'}.";
        ];
    };
    conclude: null
}

tpg ReturnedOperand(E: Operation, Left: Expr, Returned: Expr, Other: Expr, T: Outcome) {
    var B : LogicalOperation = (E as class:LogicalOperation);
    agg hyp {
        _ -> {
            fragment:operandReturned(Returned)
        };
        _ -> {
            agg and {
                _ -> {
                    conclude: error [
                        skill = "logical_returned_operand";
                        hypothesis = "and_or_confused";
                        RU.explanation = "${B.class()} останавливается на первом ${B.returnsLeftWhenLeftTruthy ? 'истинном' : 'ложном'} операнде, а не на первом ${B.returnsLeftWhenLeftTruthy ? 'ложном' : 'истинном'}.";
                        EN.explanation = "the ${B.class()} stops at the first ${B.returnsLeftWhenLeftTruthy ? 'truthy' : 'falsy'} operand, not at the first ${B.returnsLeftWhenLeftTruthy ? 'falsy' : 'truthy'} one.";
                        RU.reason = "Возвращается первый ${B.returnsLeftWhenLeftTruthy ? 'ложный' : 'истинный'} операнд.";
                        EN.reason = "The first ${B.returnsLeftWhenLeftTruthy ? 'falsy' : 'truthy'} operand is returned.";
                    ]
                };
                _ -> {
                    fragment:operandReturned(Other)
                };
                correct -> { conclude: correct };
                error -> { conclude: error };
                null -> { conclude: null };
            }
        };
        correct -> { conclude: correct };
        error -> { conclude: error };
        null -> { conclude: null };
    } as operatorSemantics
}
[
    RU.error_prefix = "Выражение ${E} ${T is class:EvaluationError ? 'не может вызвать ошибку' : 'не может иметь тип'} ${T}, потому что ";
    EN.error_prefix = "The expression ${E} ${T is class:EvaluationError ? 'cannot cause the error' : 'cannot have the type'} ${T} because ";
    RU.hint_prefix = "Выражение ${E} ${T is class:EvaluationError ? 'вызывает ошибку' : 'имеет тип'} ${T}, потому что ";
    EN.hint_prefix = "The expression ${E} ${T is class:EvaluationError ? 'causes the error' : 'has the type'} ${T} because ";
    RU.misreasoning_prefix = "Выражение ${E} действительно ${T is class:EvaluationError ? 'вызывает ошибку' : 'имеет тип'} ${T}, но рассуждение ошибочно: ";
    EN.misreasoning_prefix = "The expression ${E} does ${T is class:EvaluationError ? 'cause the error' : 'have the type'} ${T}, but the reasoning is wrong: ";
    RU.error_statement = "Выражение ${E} ${T is class:EvaluationError ? 'не может вызвать ошибку' : 'не может иметь тип'} ${T}.";
    EN.error_statement = "The expression ${E} ${T is class:EvaluationError ? 'cannot cause the error' : 'cannot have the type'} ${T}.";
]

// Решение студента «на каком операнде останавливается операция»: навык его неверного выхода.
meta for operatorSemantics [
    skill = "logical_returned_operand";
]
