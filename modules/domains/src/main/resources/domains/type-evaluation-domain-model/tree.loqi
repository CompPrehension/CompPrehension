// Ответ студента объясняется прочтениями выражения: выражение как написано (правило и заблуждения — дерево typed)
// или выражение, в котором операнд прочитан как похожая на него переменная из условия. Прочтение объясняет ответ T,
// если по правилам оно даёт ровно T. Если ни одно прочтение ответ не объяснило, он ошибочен по запасному выводу.

lambda looksAlike(A: Variable, B: Variable) = A=>looksLike(B) or A=>lookedLikeBy(B);

tpg ExprType(E: Operation, T: Outcome) {
    // Тип среза кортежа зависит от границ, а арифметики в LOQI нет: такие ответы дерево не оценивает.
    ask (E is class:SlicingOperation and E->hasOperand<OperandPlacement:left>->hasType is class:TupleType) out false else {
        conclude: null
    };
    agg hyp {
        _ -> {
            conclude: subcall("typed", E, E, E, T)
        };
        _ -> {
            cycle hyp (E=>hasOperand<OperandPlacement:left>($O) or E=>hasOperand<OperandPlacement:right>($O)) with Expr O {
                _ -> {
                    cycle hyp ($V == O or O is class:Variable and looksAlike($V, (O as class:Variable))) with Variable V {
                        _ -> {
                            ask (subcall("typed", E, O, V, T) == true) {
                                true -> {
                                    ask (V == O) {
                                        true -> {
                                            conclude: correct [
                                                skill = "operand_identification";
                                                hypothesis = "rule";
                                            ]
                                        };
                                        false -> {
                                            conclude: error [
                                                skill = "operand_identification";
                                                hypothesis = "variable_confused";
                                                // У двух операндов место называется явно: похожая переменная может стоять в том же выражении.
                                                RU.explanation = "${(E is class:CallOperation or E is class:NegationOperation) ? 'в выражении стоит' : (E=>hasOperand<OperandPlacement:left>(O) ? 'левый операнд —' : 'правый операнд —')} ${O}, а не ${V}.";
                                                EN.explanation = "${(E is class:CallOperation or E is class:NegationOperation) ? 'the expression uses' : (E=>hasOperand<OperandPlacement:left>(O) ? 'the left operand is' : 'the right operand is')} ${O}, not ${V}.";
                                                RU.reason = "Мне показалось, что ${(E is class:CallOperation or E is class:NegationOperation) ? 'в выражении стоит' : (E=>hasOperand<OperandPlacement:left>(O) ? 'левый операнд —' : 'правый операнд —')} ${V}, а не ${O}.";
                                                EN.reason = "It seemed to me that ${(E is class:CallOperation or E is class:NegationOperation) ? 'the expression uses' : (E=>hasOperand<OperandPlacement:left>(O) ? 'the left operand is' : 'the right operand is')} ${V}, not ${O}.";
                                            ]
                                        };
                                    } as operandIdentification
                                };
                                false -> {
                                    conclude: null
                                };
                            }
                        };
                        correct -> { conclude: correct };
                        error -> { conclude: error };
                        null -> { conclude: null };
                    }
                };
                correct -> { conclude: correct };
                error -> { conclude: error };
                null -> { conclude: null };
            }
        };
        correct -> { conclude: correct };
        error -> { conclude: error };
        null -> { conclude: error };
    } as readings
}
[
    RU.error_prefix = "Выражение ${E} ${T is class:EvaluationError ? 'не может вызвать ошибку' : 'не может иметь тип'} ${T}, потому что ";
    EN.error_prefix = "The expression ${E} ${T is class:EvaluationError ? 'cannot cause the error' : 'cannot have the type'} ${T} because ";
    RU.hint_prefix = "Выражение ${E} ${T is class:EvaluationError ? 'вызывает ошибку' : 'имеет тип'} ${T}, потому что ";
    EN.hint_prefix = "The expression ${E} ${T is class:EvaluationError ? 'causes the error' : 'has the type'} ${T} because ";
    RU.misreasoning_prefix = "Выражение ${E} действительно ${T is class:EvaluationError ? 'вызывает ошибку' : 'имеет тип'} ${T}, но рассуждение ошибочно: ";
    EN.misreasoning_prefix = "The expression ${E} does ${T is class:EvaluationError ? 'cause the error' : 'have the type'} ${T}, but the reasoning is wrong: ";
    RU.error_statement = "Выражение ${E} ${T is class:EvaluationError ? 'не может вызвать ошибку' : 'не может иметь тип'} ${T}.";
    EN.error_statement = "The expression ${E} ${T is class:EvaluationError ? 'cannot cause the error' : 'cannot have the type'} ${T}.";
    RU.clarification_prompt = "Почему вы ${T is class:EvaluationError ? 'решили, что здесь возникнет ошибка' : 'выбрали тип'} ${T}?";
    EN.clarification_prompt = "Why did you ${T is class:EvaluationError ? 'decide that this causes the error' : 'choose the type'} ${T}?";
]

// Навык — последняя развилка перед выводом correct/error, у которой к таким выводам ведут хотя бы два выхода.
meta for operandIdentification [
    skill = "operand_identification";
]
