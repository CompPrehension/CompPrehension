<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>compprehension-modules</artifactId>
        <groupId>org.vstu.compprehension</groupId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>core-api</artifactId>
    <packaging>jar</packaging>
    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <!--
        Публичный контракт предметного ядра: Domain/Backend/AbstractStrategy, словарь
        (Question, Law, Concept, ...), модели data.*, и интерфейсы тех немногих сервисов,
        которые нужны доменам/бэкендам/стратегиям напрямую. Никаких JPA-сущностей,
        Spring Data репозиториев и конкретных реализаций сервисов — это остаётся в core.
        backends/domains/strategies зависят только от этого модуля, а не от core: импорт
        entities.*/repositories.*/внутреннего сервиса отсюда физически не скомпилируется.
    -->

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>org.vstu.compprehension</groupId>
            <artifactId>common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${springcore.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>${springcore.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
            <version>${spring.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.github.brookite</groupId>
            <artifactId>StringTermAnnotator</artifactId>
            <version>fa8fed42c6</version>
        </dependency>
        <dependency>
            <groupId>com.github.CompPrehension</groupId>
            <artifactId>its_Reasoner</artifactId>
            <version>3.0.0-alpha.2</version>
        </dependency>
        <dependency>
            <groupId>com.github.CompPrehension</groupId>
            <artifactId>its_QuestionGen</artifactId>
            <version>2.7.6</version>
        </dependency>
    </dependencies>
</project>
