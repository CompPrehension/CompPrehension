		EN.localizedName = "false" ;
	],
	any [
		RU.localizedName = "любое" ;
		EN.localizedName = "any value" ;
	],
	no_value [
		RU.localizedName = "нет значения" ;
		EN.localizedName = "no value" ;
	],
} [
	RU.localizedName = "значение условия" ;
	EN.localizedName = "condition value" ;
]


