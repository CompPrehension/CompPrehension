// Уровень абстракций управляющих конструкций //


class Effect {
	obj prop interruption_stop: InterruptionType ;
	obj prop interruption_start: InterruptionType ;
	obj prop call_stack: CallStackAction ;
} [
	RU.localizedName = "эффект" ;
	EN.localizedName = "effect" ;

]


class Behaviour {
	obj prop assumed_value: OptionalBoolValue ;  // Когда соответствующее действие отсутствует в AST (опущено)
} [
	RU.localizedName = "поведение" ;
	EN.localizedName = "behaviour" ;

]

class Constraint {
	obj prop condition_value: OptionalBoolValue ;
	obj prop interruption_mode: InterruptionType ;
} [
	RU.localizedName = "ограничение" ;
	EN.localizedName = "constraint" ;
]

class ActionSpec {
	obj prop role: string ;
	obj prop generalization: string ;
	obj prop kind: string ;
	obj prop appearanceType: AppearanceType ;
	obj prop _locale_trace_name: string ;
	obj prop _locale_pronoun: string ;  // he she it

	rel hasConstruct(ConstructSpec) ;
	rel hasEffects(Effect) ;
	rel hasBehaviour(Behaviour) : {* -> 1} ;
} [
	RU.localizedName = "спецификация действия" ;
	EN.localizedName = "action specification" ;
]

class TransitionSpec {
	rel from_(ActionSpec): {* -> 1};
	rel to_(ActionSpec): {* -> 1};
	rel to_when_absent(ActionSpec): {* -> 2};

	rel hasConstruct(ConstructSpec) ;
	rel hasConstraints(Constraint) ;
	rel hasEffects(Effect) ;
} [
	RU.localizedName = "спецификация перехода" ;
	EN.localizedName = "transition specification" ;

]

class ConstructSpec {
	obj prop name: string ;
	obj prop kind: string ;
	obj prop _locale_trace_name: string ;
	obj prop _locale_pronoun: string ;  // he she it

	rel hasActions(ActionSpec) ;
	rel hasTransitions(TransitionSpec) ;
	rel belongsToASTNode(ASTNodeWrapper) : {* -> 1} ;
	rel hasEffects(Effect) ;
} [
	RU.localizedName = "спецификация конструкции" ;
	EN.localizedName = "construct specification" ;
]



// Уровень CFG - Control Flow Graph //


class Metadata {
	obj prop primary: bool ;
	obj prop is_after_last: bool ;
	obj prop call_count: int[0, 65536] ;

	rel hasAbstractAction(ActionSpec) : {* -> 1} ;
	rel belongsToASTNode(ASTNodeWrapper) : {* -> 1} ;
	rel hasAbstractTransition(TransitionSpec) : {* -> 1} ;
	rel hasCorrespondingEnd(Node) : {* -> 1} ;
} [
	RU.localizedName = "метаданные" ;
	EN.localizedName = "metadata" ;

]

class Node {
	obj prop id: string ;
	obj prop kind: NodeKind ;

	rel belongsTo(CFG) : opposite to CFG->hasNodes ;
	rel hasEffects(Effect) ;
	rel hasMetadata(Metadata) : {* -> 1};

	rel hasEdges(Edge) : opposite to Edge->hasSource ;
	rel startsPath(PathInfo) : opposite to PathInfo->from_;
	rel endsPath(PathInfo) : opposite to PathInfo->to_;
} [
	RU.localizedName = "узел" ;
	EN.localizedName = "node" ;
]


class Edge {
	obj prop id: string ;

	rel belongsTo(CFG) : opposite to CFG->hasEdges ;
	rel hasSource(Node) : {* -> 1} ;
	rel hasDestination(Node) : {* -> 1} ;
	rel hasMetadata(Metadata) : {* -> 1};
	rel hasEffects(Effect) ;
	rel hasConstraints(Constraint) ;
} [
	RU.localizedName = "ребро" ;
	EN.localizedName = "edge" ;
]

class CFG {
	obj prop id: string ;
	obj prop name: string ;

	rel hasNodes(Node) : {1 -> *} ;
	rel hasEdges(Edge) : {1 -> *} ;
	rel hasBegin(Node) : {1 -> 1} ;
	rel hasEnd(Node) : {1 -> 1} ;
} [
	RU.localizedName = "граф потока управления" ;
	EN.localizedName = "control flow graph" ;
]


class PathInfo {
	obj prop id: string ;
	obj prop is_direct: bool ;
	obj prop ast_actions: int[0, 65536] ;
	obj prop transparent_actions: int[0, 65536] ;
	obj prop opaque_actions: int[0, 65536] ;
	obj prop conditions: int[0, 65536] ;  // Непрозрачные (TODO)
	obj prop frame_changes: int[0, 65536] ;
	obj prop frames_added: int[0, 65536] ;
	obj prop frames_dropped: int[0, 65536] ;

	rel from_(Node) : {* -> 1} ;  // opposite to Node->startsPath
	rel to_(Node) : {* -> 1} ;  // opposite to Node->endsPath
	rel hasEffects(Effect) : {* -> *} ;
	rel hasConstraints(Constraint) : {* -> 1} ;

	rel hasFirstMiddleAction(Node) : {* -> 1} ;
	rel hasFirstMiddleCondition(Node) : {* -> 1} ;
	rel hasFirstMiddleFrameChange(Node) : {* -> 1} ;
} [
	RU.localizedName = "Путь по графу CFG и информация о достижимости" ;
	EN.localizedName = "Path within a CFG & reachability info" ;
]


// Уровень условия задачи -- конкретного AST //

class ASTNodeWrapper {
	obj prop ast_id: int ;
	obj prop ast_node: string ;
	obj prop _code_piece: string ;  // имя действия для трассы

	rel hasParent(ASTNodeWrapper) : {* -> 1} ;
	rel hasChildren(ASTNodeWrapper) ;
	rel hasMetadata(Metadata) : {* -> 1};
} [
	RU.localizedName = "обёртка узла AST" ;
	EN.localizedName = "AST node wrapper" ;
]

// ... Что-то про цепочки значения условий ???



// Уровень выполнения задачи -- трассы //

class State {
	obj prop interruption_state: InterruptionType ;

	rel hasLastConditionAction(ActionSpec);
	// + значение этого условия (T/F) ???
}


class TraceAct {
	obj prop is_known_correct: bool ;
	obj prop condition_value: OptionalBoolValue ; // используем

	rel hasCFGNode(Node) : {* -> 1};
	rel hasActionSpec(ActionSpec) : {* -> 1};
	rel hasASTNode(ASTNodeWrapper) : {* -> 1} ;
	rel hasActAsCorrespondingEnd(TraceAct) : {1 -> *} ;
	
	rel directlyBeforeOf(TraceAct) : linear ;
	rel directlyAfterOf(TraceAct) : opposite to directlyBeforeOf ;
	rel beforeOf(TraceAct) : transitive to directlyBeforeOf ;
	rel afterOf(TraceAct) : transitive to directlyAfterOf ;
	rel isBetween(TraceAct, TraceAct) : between to beforeOf ;
	rel isCloserToThan(TraceAct, TraceAct) : closer to beforeOf ;
	rel isFurtherFromThan(TraceAct, TraceAct) : further to beforeOf ;
	rel hasNextTraceAct(TraceAct) : {1 -> 1} ;   // Линейное отношение "непосредственно следующий" в цепочке актов трассы
} [
	RU.localizedName = "действие в трассе" ;
	EN.localizedName = "trace act" ;
]



