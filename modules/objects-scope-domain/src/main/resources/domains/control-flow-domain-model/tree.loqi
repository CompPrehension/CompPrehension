tree CtrlFlow(L0: TraceAct, A: TraceAct, STATE: State) {

    // Заранее берём ожидаемый узел из трассы.
    var ExpectedCallAct : TraceAct = (L0->directlyBeforeOf);

    //  Для каждого пути от L0 до A
    // (ищем допустимый вариант применения пути, -- достаточно одного правильно применённого пути: OR)

    cycle or (forAll PathInfo p [$p=>from_(L0->hasCFGNode) and $p=>to_(A->hasCFGNode)] {$p=>from_(L0->hasCFGNode) and $p=>to_(A->hasCFGNode)}) with PathInfo P_l0_a {
    // cycle or (forAll PathInfo p {$p=>from_(L0->hasCFGNode) and $p=>to_(A->hasCFGNode)}) with PathInfo P_l0_a {

        true -> out;

        false -> {
            conclude : error [
                skill = "DEBUG: final error.";
            ];
        };

        null -> {
            // Скачок в неизвестном направлении ...

            // Поищем обратный путь (когда А в недалёком прошлом).
            // Существует ли какой угодно путь от A до L0 ?
            ask (forAny PathInfo p4 {A->hasCFGNode=>startsPath($p4) and $p4->to_ == L0->hasCFGNode}) out true else {
                // НЕТ: дальше проверять нет смысла.
                conclude: error [
                    skill="DEBUG: nowhere";
                    RU.explanation="${A} не может выполняться сейчас, т.к. по логике выполнения программы находится слишком далеко от текущей позиции ${L0}.";
                ];
                // conclude : null;
            };

            // Выполнено ли действие A в трассе, т.е. имеет акт ?
            ask (forAny TraceAct prev [$prev.is_known_correct == true] {$prev->hasCFGNode == A->hasCFGNode}) out true else {
                // Не было и не будет в ближайшей перспективе.
                conclude: error [
                    skill="refer_execution_history";
                    RU.explanation="В программе всё выполняется одно за другим. После ${L0} действие ${A} уже не может выполниться.";
                ];
            };
            // Действие не было выполнено в трассе, т.е. не имеет акта.

            // Действие A выполнено два раза подряд (A == L0) ?
            ask (L0->hasCFGNode == A->hasCFGNode) out false else {
                conclude: error [
                    skill="repeat_twice";
                    RU.explanation="${A}: уже выполнилось и не должно выполняться два раза подряд.";
                ];
            };

            // Действие А нельзя выполнять сейчас, так как находятся в иной области кода, чем L0
            conclude: error [
                skill="two_execution_points_has_path";
                RU.explanation="Действие ${A} уже выполнилось и не должно выполняться повторно.";
                ];

            // conclude : error [
            //     skill = "DEBUG: to-nowhere, NULL.";
            // ];
        };

        body -> {
// ============ BEGIN of main path P processing ============


///
ask ((P_l0_a->from_ == L0->hasCFGNode) and (P_l0_a->to_ == A->hasCFGNode)) out true else {

    conclude : null [
        skill="DEBUG: CONTINUE";
    ];
};


// ///
// ask (true) out false else {

//     conclude : correct [
//         skill="DEBUGGUNG";
//     ];
// };
// ///


// Проверка прерывания.
// --------------------
// Есть ли сейчас незавершённое прерывание ?
ask (STATE.interruption_state != InterruptionType:no_interruption) {
    false -> out;  // (нет прерывания)
    true -> {
        // Есть незавершённое прерывание.
        // Обработка прерывания.

        // /!\  ⚠  (точка выхода из прерывания НЕ ОБЯЗАТЕЛЬНО является нажимаемой кнопкой, выполнение может "перескочить" через неё)

        // Имеет ли путь P входное ограничение на режим прерывания ?
        ask (forAny Constraint c {P_l0_a=>hasConstraints($c) and P_l0_a->hasConstraints.interruption_mode != InterruptionType:no_interruption}) out true else {
            conclude : error [
                skill="interruption_state_matches_constraint";
                RU.explanation="Сейчас ${A} не может начать выполняться, т.к. может бы выполняться только при обычном потоке выполнения, когда отсутствует ${STATE.interruption_state}.";
            ];
        };

        // Является ли A завершением ?
        ask (A->hasCFGNode.kind == NodeKind:END) out true else {

            // Имеет ли путь P эффект остановки прерывания ?

            ask (forAny Effect ef {P_l0_a=>hasEffects($ef) and $ef.interruption_stop != InterruptionType:no_interruption}) out true else {
                conclude : error [
                    skill="DEBUG: interruption_continues (1)";
                    RU.explanation="Когда происходит ${STATE.interruption_state}, могут только завершаться составные действия; ${A} не может начать выполняться.";
                ];
            };

            // Может ли эффект остановки прерывания пути P остановить текущее прерывание ?
            // покрывает: или == STATE, или generic_interruption, или any

            cycle and (forAll Effect ef [P_l0_a=>hasEffects($ef)] {(
                    $ef.interruption_stop == STATE.interruption_state or
                    $ef.interruption_stop == InterruptionType:generic_interruption or
                    $ef.interruption_stop == InterruptionType:any
                )}) with Effect ThisPathEffect {

                true -> {
                    conclude : error [
                        skill = "DEBUG: never happens: true outcome while the loop contains error only.";
                    ];
                };
                false -> {
                    conclude : error [
                        skill = "DEBUG: interruption_continues out.";
                    ];
                };
                null -> out;
                body -> {

                    conclude : error [
                        skill="DEBUG: interruption_continues in  body";
                        RU.explanation="${STATE.interruption_state} не может окончиться здесь, чтобы перейти к ${A}. Сейчас происходит не ${ThisPathEffect.interruption_stop}.";
                    ];
                };
            };


            // Прерывание было корректно завершено эффектом на этом пути.

            conclude : correct [
                // Прерывание пройдено верно.
                skill = "interruption_state_matches_constraint";
            ];
        };


        // ... `A` является завершением.

        // Является ли A завершением некоторого действия, вызванного ранее и ещё не завершившегося
        // (и т. обр. являющегося родительским для L0)?
        /// (pa = previous act)
        ask (forAny TraceAct pa {
                A->hasCFGNode == $pa->hasCFGNode and
                $pa.is_known_correct == false and
                (forAny TraceAct cb {$pa=>hasActAsCorrespondingEnd($cb) and  // relation exists
                $cb.is_known_correct == true})
            }) out true else {
            conclude : error [
                skill="DEBUG: interruption_continues, not run.";
                RU.explanation="Когда происходит ${STATE.interruption_state}, могут завершаться только уже начавшиеся действия; $A сейчас не выполняется.";
            ];
        };

        // Является ли путь P прямым (нет промежуточных обязательных действий) ?

        ask (P_l0_a.is_direct) out false else {
            conclude : correct [
                skill="DEBUG_interruption_correct";
                RU.explanation="${STATE.interruption_state} после действия ${L0} применен(о) верно.";
            ];
        };

        // (Найти первое из пропущенных действий на пути P -- это hasFirstMiddleAction)

        conclude : error [
            skill="DEBUG: interruption_early_end";
            RU.explanation="Когда происходит ${STATE.interruption_state}, ожидается завершение начавшихся действий; прежде чем завершать ${A}, нужно сначала завершить ${P_l0_a->hasFirstMiddleAction}.";
        ];
    };
};




//                    +
//                  + + +
//                    +




// Обычный поток выполнения, без прерывания ...
// --------------------


// Является ли путь P прямым (нет промежуточных обязательных действий) ?

ask (P_l0_a.is_direct) out true else {

    // Путь не прямой; уточним степень ошибки.

    // Присутствуют ли непрозрачные УСЛОВИЯ на пути P ?

    ask (forAny Node n {P_l0_a=>hasFirstMiddleCondition($n)}) out false else {
        // Найти первое непрозрачное УСЛОВИЕ на пути P...

        conclude : error [
            skill="DEBUG: too_early_skipped_cond";
            RU.explanation="Прежде чем ${A} сможет выполниться, как минимум, должно быть вычислено условие ${P_l0_a->hasFirstMiddleCondition}.";
        ];
    };

    // Найти первое непрозрачное Действие на пути P...

    conclude : error [
        skill="DEBUG: too_early_skipped_action";
        RU.explanation="Действия выполняются последовательно; прежде чем выполнять ${A}, сначала должно произойти ${P_l0_a->hasFirstMiddleAction}.";
    ];
};





// Путь прямой; возможно, даже корректный.

// Проверка применимости пути P ...

agg and {

    // Учтено ли ограничение на режим прерывания ?
    interruptionConstraint -> {
        // Здесь должно быть: STATE.interruption_state == no_interruption.

        // Имеет ли путь P входное ограничение на режим прерывания ?
        // Входное ограничение на режим прерывания пути P равно ANY (применимо в любом случае) ?

        ask (P_l0_a->hasConstraints.interruption_mode == InterruptionType:any) out false else {
            conclude : true;
        };

        // Входное ограничение на режим прерывания пути P равно текущему или совместимо с ним ?
        ask (STATE.interruption_state == P_l0_a->hasConstraints.interruption_mode or
            P_l0_a->hasConstraints.interruption_mode == InterruptionType:generic_interruption
            ) out false else {
            conclude: true;
        };

        // Найти (другой) прямой путь из L0, который применим при отсутствии прерывания
        // → EP (Expected Path)

        cycle and (forAll PathInfo ep [$ep=>from_(P_l0_a->from_)] {$ep.is_direct and ($ep->hasConstraints.interruption_mode == InterruptionType:any or $ep->hasConstraints.interruption_mode == STATE.interruption_state)}) with PathInfo EP {

            // // Прервать цикл, если не соответствует условию цикла (workaround).
            // ask (EP=>from_(P_l0_a->from_) and EP.is_direct and
            //     (EP->hasConstraints.interruption_mode == InterruptionType:any or
            //         EP->hasConstraints.interruption_mode == STATE.interruption_state)
            //     ) out true else {

            //     conclude : null [
            //         skill="DEBUG (EP): CONTINUE";
            //     ];
            // };


            null -> {conclude : error [
                skill="interruption_state_matches_constraint";
                RU.explanation="Когда происходит ${STATE.interruption_state}, ${A} не может выполняться, т.к. для этого требуется ${P_l0_a->hasConstraints.interruption_mode}.";
            ];}
            false -> {conclude : error [
                skill="interruption_state_matches_constraint";
                RU.explanation="Когда происходит ${STATE.interruption_state}, ${A} не может выполняться, т.к. для этого требуется ${P_l0_a->hasConstraints.interruption_mode}.";
            ];}
            body -> {

                conclude : error [
                    skill="interruption_state_matches_constraint";
                    RU.explanation="Когда происходит ${STATE.interruption_state}, должно выполниться действие ${EP->to_}, но не ${A}";
                ];
            }
        };
    };  // end of agg branch.


    // Не препятствует ли условие ?
    conditionCheck -> {
        // Не препятствует ли условие тому, чтобы пройти по маршруту P ?..

        // Есть ли для пути P входное ограничение на значение условия ?
        // Наложены ли на маршрут ограничения на значение условия?
        ask (forAny Constraint c {P_l0_a=>hasConstraints($c)} and P_l0_a->hasConstraints.condition_value != OptionalBoolValue:no_value) out true else {
            // НЕТ: дальше проверять нет смысла.
            conclude : true;
        };
        // Совпадает ли значение текущего условия с ожидаемым условием для маршрута P ?
        ask (L0.condition_value == P_l0_a->hasConstraints.condition_value)
        out false else {
            // ДА: ошибки нет.
            // TODO: Добавить скилл condition_value_allows_transition (здесь он применён правильно)
            conclude : true;
        };

        // Найти (другой) путь из L0, который проходит по ограничению условия в текущей ситуации
        // → EP (Expected Path)
        cycle and (forAll PathInfo ep2 [$ep2=>from_(P_l0_a->from_)] {L0.condition_value == $ep2->hasConstraints.condition_value}) with PathInfo EP2 {

            null -> {conclude : error [
                skill="condition_value_allows_transition";
                RU.explanation="Когда условие ${L0} равно ${L0.condition_value} ${A} не может выполняться, т.к. для этого требуется ${P_l0_a->hasConstraints.condition_value} в условии.";
            ];}
            false -> {conclude : error [
                skill="condition_value_allows_transition";
                RU.explanation="Когда условие ${L0} равно ${L0.condition_value} ${A} не может выполняться, т.к. для этого требуется ${P_l0_a->hasConstraints.condition_value} в условии.";
            ];}
            body -> {
                conclude : error [
                    skill="condition_value_allows_transition";
                    RU.explanation="Когда условие ${L0} равно ${L0.condition_value}, должно выполняться действие ${EP2->to_}, но не ${A}.";
                ];
            }
        };
    };  // end of agg branch.


    // В правильный ли вызов функции вернулись ?
    // (CFG не даёт нам информации об этом, так как считает, что возврат из функции в любой из её вызовов допустИм.)

    functionReturn -> {
        // Является ли А завершением вызова некоторой функции?
        ask (A->hasASTNode.ast_node == "function_call" and A->hasCFGNode.kind == NodeKind:END) out true else {
            // НЕТ: Дальше не проверяем.
            conclude : true [
                skill = "DEBUG: not-a-call.";
            ];
        };
        // Является ли А завершением именно самого близкого по трассе к L0 вызова этой же функции ( который при этом не имел на завершения?)
        // var closerCall : TraceAct = findExtreme func [$func=>isCloserToThan($act, L0) and $func->hasASTNode== A->hasASTNode and $func.is_known_correct
        //     ] among TraceAct act {$act->hasASTNode.ast_node == "function_call" and
        //         $act->hasCFGNode.kind == NodeKind:BEGIN
        //         and
        //         not (forAny TraceAct _e {$act=>hasActAsCorrespondingEnd($_e)})}

        // Тупо используем ожидаемый узел из трассы.
        ask (ExpectedCallAct->hasASTNode.ast_node == "function_call" and ExpectedCallAct->hasCFGNode.kind == NodeKind:END) out true else {
            conclude : error [
                skill="is_function_call_ended_at_time";
                RU.explanation="Функция не может завершиться сейчас. Вместо ${A} нужно завершить ${ExpectedCallAct->hasCFGNode}.";
            ];
        };
        ask (A->hasASTNode == ExpectedCallAct->hasASTNode)
        out false else {
            // ДА: Вернулись в нужный вызов.
            // TODO: Добавить скилл is_function_call_jumping_correct как корректно применённый.
            conclude : null [
                skill = "DEBUG: RETURN is OK";
            ];
        };
        conclude : error [
            skill="is_function_call_jumping_correct";
            RU.explanation="При завершении вызовов сначала завершаются внутренние вызовы согласно стеку вызовов (в обратном порядке). Вместо ${A} нужно завершить ${ExpectedCallAct}.";
        ];
    };  // end of agg branch.

};


// // Найти непрозрачное действие на пути
// var Missing : Node = find Node m { P_l0_a=>hasFirstMiddleAction($m) } out false else {
//     // Найдено непрозрачное действие.
//     conclude : error [
//         skill="is_in_nested_construct";
//         RU.explanation="Когда происходит ${STATE.interruption_state}, досрочно завершается то, что уже началось. Прежде чем завершать ${A}, нужно сначала завершить ${Missing}.";
//     ];
// };

// conclude : correct [
//     skill="selected_transition_without_any_constraint";
// ];
// conclude : true [
//     skill="selected_transition_without_any_constraint";
// ];


// ============ END of main path P processing ============
        };
    };



    conclude : correct [
        skill="selected_transition_without_any_constraint";
    ];
}
